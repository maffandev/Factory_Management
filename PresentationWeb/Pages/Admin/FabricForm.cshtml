@page "/Admin/Fabrics"
@model FabricsModel
@{
    ViewData["Title"] = "Fabrics";
    var units = new[] { "Meter", "Yard", "Kg" };
}

@await Html.PartialAsync("_Navbar")
@Html.AntiForgeryToken()

<div class="container-fluid px-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Fabrics</h4>
        <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm"><span class="bi bi-arrow-left"></span> Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2">@TempData["ErrorMessage"]</div>
    }

    @* The four cards below update live with the search / stock filter (see the script
       at the bottom of this page). Searching "Nishat" shows only Nishat's stock value
       and purchased amount; clearing the filter shows the totals for all fabrics. *@
    <div class="row g-3 mb-3">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-success h-100"><div class="card-body py-3">
                <div class="text-muted small">Available Stock Value <span class="badge text-bg-light border" id="sumScopeAll">ALL</span></div>
                <div class="fs-4 fw-bold text-success">Rs. <span id="sumAvailValue">@Model.TotalAvailableStockValue.ToString("N2")</span></div>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-info h-100"><div class="card-body py-3">
                <div class="text-muted small">Purchased Amount <span class="badge text-bg-light border" id="sumScopeAll2">ALL</span></div>
                <div class="fs-4 fw-bold text-info">Rs. <span id="sumTotalAmount">@Model.AllFabrics.Sum(f => f.TotalAmount).ToString("N2")</span></div>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body py-3">
                <div class="text-muted small">In Stock</div>
                <div class="fs-4 fw-bold text-primary"><span id="sumInStock">@Model.InStockCount</span> <span class="fs-6 fw-normal text-muted">color(s)</span></div>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body py-3">
                <div class="text-muted small">Out of Stock</div>
                <div class="fs-4 fw-bold text-danger"><span id="sumOutOfStock">@Model.OutOfStockCount</span> <span class="fs-6 fw-normal text-muted">color(s)</span></div>
            </div></div>
        </div>
        <div class="col-12">
            <div id="filterInfo" class="small text-muted d-none">
                <span class="bi bi-funnel"></span> <span id="filterInfoText"></span>
            </div>
        </div>
    </div>

    <!-- Add Fabric -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">Add Fabric</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Add">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Fabric Code <span class="text-danger">*</span></label>
                        <input asp-for="AddFabric.FabricCode" class="form-control" required />
                        <span asp-validation-for="AddFabric.FabricCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fabric Type <span class="text-danger">*</span></label>
                        <input asp-for="AddFabric.FabricType" class="form-control" required />
                        <span asp-validation-for="AddFabric.FabricType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fabric Colour <span class="text-danger">*</span></label>
                        <input asp-for="AddFabric.Color" class="form-control" required />
                        <span asp-validation-for="AddFabric.Color" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Invoice #</label>
                        <input asp-for="AddFabric.InvNum" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fabric Date</label>
                        <input asp-for="AddFabric.FabricDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fabric By <span class="text-muted fw-normal small">(company)</span></label>
                        <input asp-for="AddFabric.FabricBy" class="form-control" maxlength="150" placeholder="Leave empty for Factory Management" />
                        <div class="form-text">The company this fabric came from. If left empty, <strong>Factory Management</strong> is saved.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Quantity</label>
                        <input asp-for="AddFabric.Quantity" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Unit</label>
                        <select asp-for="AddFabric.Unit" class="form-select">
                            @foreach (var u in units)
                            {
                                <option value="@u">@u</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Rate</label>
                        <input asp-for="AddFabric.Rate" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <span class="bi bi-plus-lg me-1"></span>Create Fabric
                        </button>
                    </div>
                </div>
                <div asp-validation-summary="ModelOnly" class="text-danger small mt-2"></div>
            </form>
        </div>
    </div>

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-6">
                    <input type="text" class="form-control" id="fabricSearch" placeholder="Search by code, colour, type, invoice or company..." autocomplete="off" />
                </div>
                <div class="col-md-4">
                    <select class="form-select" id="stockFilter">
                        <option value="all">All (in and out of stock)</option>
                        <option value="InStock">In stock only</option>
                        <option value="OutOfStock">Out of stock only</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="button" class="btn btn-outline-secondary" id="btnClearSearch">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <!-- All Fabrics table -->
    <div class="card shadow-sm">
        <div class="card-header">All Fabrics <span class="text-muted fw-normal small">(out-of-stock items included — for topping up)</span></div>
        <div class="card-body table-responsive">
            @if (Model.AllFabrics.Any())
            {
                <table class="table table-hover align-middle mb-0" id="fabricTable">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Inv #</th>
                            <th>Date</th>
                            <th>Fabric By</th>
                            <th>Type</th>
                            <th>Colour</th>
                            <th>Total Purchased</th>
                            <th>Available</th>
                            <th>Status</th>
                            <th>Rate</th>
                            <th>Total Amount</th>
                            <th>Fabric Out</th>
                            <th>Avail. Amount</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Model.AllFabrics.GroupBy(f => f.FabricCode))
                        {
                            var variants = group.OrderBy(f => f.Color).ToList();
                            for (var i = 0; i < variants.Count; i++)
                            {
                                var f = variants[i];
                                var isOut = f.Status != "InStock";
                                <tr data-search="@($"{f.FabricCode} {f.FabricType} {f.Color} {f.FabricBy} {f.InvNum}")"
                                    data-status="@(isOut ? "OutOfStock" : "InStock")"
                                    data-avail="@f.AvailableQuantity"
                                    data-rate="@f.Rate"
                                    data-amount="@f.TotalAmount"
                                    class="@(isOut ? "fabric-row-out" : "")">
                                    @if (i == 0)
                                    {
                                        <td class="fw-semibold align-top" rowspan="@variants.Count">@f.FabricCode<br/><span class="badge text-bg-secondary">@variants.Count color(s)</span></td>
                                        <td class="align-top" rowspan="@variants.Count">@(f.InvNum ?? "—")</td>
                                        <td class="align-top" rowspan="@variants.Count">@(f.FabricDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                        <td class="align-top" rowspan="@variants.Count">@(string.IsNullOrWhiteSpace(f.FabricBy) ? "—" : f.FabricBy)</td>
                                        <td class="align-top" rowspan="@variants.Count">@f.FabricType</td>
                                    }
                                    <td><span class="badge text-bg-light border">@f.Color</span></td>
                                    <td>@f.Quantity @f.Unit</td>
                                    @if (isOut)
                                    {
                                        <td class="fw-semibold text-danger">0 @f.Unit</td>
                                        <td><span class="badge text-bg-danger">Out of Stock</span></td>
                                    }
                                    else
                                    {
                                        <td class="fw-semibold" style="color: #d4af37;">
                                            @f.AvailableQuantity @f.Unit
                                        </td>
                                        <td><span class="badge text-bg-success">In Stock</span></td>
                                    }
                                    <td>@f.Rate.ToString("N2")</td>
                                    <td>@f.TotalAmount.ToString("N2")</td>
                                    <td class="@(f.OutQuantity > 0 ? "text-danger fw-semibold" : "text-muted")">
                                        @if (f.OutQuantity > 0)
                                        {
                                            @($"{f.OutQuantity} {f.Unit}")
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td class="fw-semibold">Rs. @f.AvailableAmount.ToString("N2")</td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-secondary edit-btn"
                                            data-id="@f.Id"><span class="bi bi-pencil"></span> Edit</button>
                                        <button type="button" class="btn btn-sm @(isOut ? "btn-warning" : "btn-outline-primary") topup-btn"
                                            data-id="@f.Id" data-code="@f.FabricCode — @f.Color" data-avail="@f.AvailableQuantity"
                                            data-unit="@f.Unit" data-rate="@f.Rate"><span class="bi bi-arrow-up-circle"></span> Top Up</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger out-btn"
                                            data-id="@f.Id" data-code="@f.FabricCode — @f.Color"
                                            data-avail="@f.AvailableQuantity" data-unit="@f.Unit">
                                            <span class="bi bi-box-arrow-right"></span> Out</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <p class="text-muted mt-3 mb-0" id="fabricEmptyMsg" style="display:none;">No fabrics match this filter. Click "Clear" to see all.</p>
            }
            else
            {
                <p class="text-muted mb-0">No fabrics yet. Add one above.</p>
            }
        </div>
    </div>
</div>

<!-- Data for each fabric needed for edit modal (JS populates modal with this data) -->
<div id="fabricData" style="display:none;">
    @foreach (var f in Model.AllFabrics)
    {
        <template class="fabric-data"
                  data-id="@f.Id"
                  data-code="@f.FabricCode"
                  data-color="@f.Color"
                  data-invnum="@(f.InvNum ?? "")"
                  data-fabricdate="@(f.FabricDate?.ToString("yyyy-MM-dd") ?? "")"
                  data-ftype="@f.FabricType"
                  data-fabricby="@(f.FabricBy ?? "")"
                  data-unit="@f.Unit"
                  data-rate="@f.Rate"
                  data-quantity="@f.Quantity"
                  data-available="@f.AvailableQuantity"></template>
    }
</div>

<!-- Edit Fabric modal -->
<div class="modal fade" id="editFabricModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <input type="hidden" asp-for="EditFabric.Id" id="efId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Fabric — <span id="efTitle"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small mb-3">
                        <span class="bi bi-info-circle"></span>
                        <strong>Company, Type, Invoice #, Unit, and Rate</strong> will apply to all colors of this Fabric Code
                        <strong>(these are master fields)</strong>.<br />
                        <strong>Date and Quantity</strong> will change only for <strong>this specific color</strong>.
                        Fabric Code and Color cannot be changed.
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Fabric Code</label>
                            <input type="text" class="form-control" id="efCode" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Color</label>
                            <input type="text" class="form-control" id="efColor" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fabric By <span class="text-muted fw-normal small">(company)</span></label>
                            <input asp-for="EditFabric.FabricBy" class="form-control" maxlength="150" placeholder="Supplier / company name" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Fabric Type <span class="text-danger">*</span></label>
                            <input asp-for="EditFabric.FabricType" class="form-control" maxlength="50" required />
                            <span asp-validation-for="EditFabric.FabricType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Invoice #</label>
                            <input asp-for="EditFabric.InvNum" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fabric Date <span class="text-muted fw-normal small">(this colour only)</span></label>
                            <input asp-for="EditFabric.FabricDate" type="date" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Unit</label>
                            <select asp-for="EditFabric.Unit" class="form-select">
                                @foreach (var u in units)
                                {
                                    <option value="@u">@u</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Rate</label>
                            <input asp-for="EditFabric.Rate" type="number" step="0.01" min="0" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Total Purchased Quantity <span class="text-muted fw-normal small">(this color only)</span></label>
                            <input asp-for="EditFabric.Quantity" type="number" step="0.01" min="0" class="form-control" />
                            <div class="form-text">Had waste or sales? Reduce the Quantity — Available will automatically adjust.</div>
                        </div>
                    </div>

                    <div class="text-muted small mt-3" id="efStockNote"></div>
                    <div asp-validation-summary="All" class="text-danger small mt-2"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><span class="bi bi-check-lg"></span> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Top Up modal -->
<div class="modal fade" id="topUpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="TopUp">
                <input type="hidden" asp-for="TopUp.FabricId" id="tuFabricId" />
                <div class="modal-header">
                    <h5 class="modal-title">Top Up Fabric — <span id="tuCode"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="text-muted small mb-3">
                        Current available: <strong id="tuAvail"></strong> · Current rate: <strong id="tuRate"></strong>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Additional Quantity <span class="text-danger">*</span></label>
                        <input asp-for="TopUp.AddedQuantity" type="number" step="0.01" min="0.01" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Rate (optional)</label>
                        <input asp-for="TopUp.NewRate" type="number" step="0.01" min="0" class="form-control" placeholder="Leave blank to keep current rate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><span class="bi bi-arrow-up-circle"></span> Top Up</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Fabric Out modal -->
<div class="modal fade" id="fabricOutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="FabricOut">
                <input type="hidden" asp-for="FabricOut.FabricId" id="foFabricId" />
                <div class="modal-header">
                    <h5 class="modal-title text-danger"><span class="bi bi-box-arrow-right"></span> Fabric Out — <span id="foCode"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning py-2 small mb-3">
                        <span class="bi bi-info-circle"></span>
                        <strong>Purchase quantity stays fixed.</strong> Only Available will decrease. OutQuantity is cumulative.
                    </div>
                    <div class="text-muted small mb-3">
                        Current available: <strong id="foAvail"></strong>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantity to Take Out <span class="text-danger">*</span></label>
                        <input asp-for="FabricOut.OutQuantity" type="number" step="0.01" min="0.01" class="form-control" required id="foQtyInput" />
                        <div class="form-text text-danger" id="foGuardMsg" style="display:none;"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="foSubmitBtn"><span class="bi bi-box-arrow-right"></span> Confirm Out</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const table = document.getElementById('fabricTable');
            const search = document.getElementById('fabricSearch');
            const stockFilter = document.getElementById('stockFilter');

            // All colours of one FabricCode are grouped together in the table, with the shared
            // cells carrying a rowspan on the group's first row. When a filter hides that first
            // row, the shared cells would disappear with it, so after filtering we move them to
            // the first still-visible row and restore the original DOM before the next filter run.
            // Shared cells = Code / Inv # / Date / Fabric By / Type.
            const SPAN_COLS = 5;

            // ------------------------------------------------------------------
            // Live totals: these follow the search and stock filter, so the cards always
            // reflect exactly the rows currently visible in the table.
            // ------------------------------------------------------------------

            // The server renders numbers in "N2" format (1,234,567.89). Rebuild the same format
            // here so the figures stay consistent once a filter recalculates them.
            function formatMoney(n) {
                const fixed = (Math.round((n || 0) * 100) / 100).toFixed(2);
                const parts = fixed.split('.');
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                return parts.join('.');
            }

            function setText(id, value) {
                const el = document.getElementById(id);
                if (el) el.textContent = value;
            }

            function updateTotals(visibleRows) {
                let availValue = 0;
                let totalAmount = 0;
                let inStock = 0;
                let outStock = 0;

                visibleRows.forEach(function (tr) {
                    const avail = parseFloat(tr.getAttribute('data-avail')) || 0;
                    const rate = parseFloat(tr.getAttribute('data-rate')) || 0;
                    availValue += avail * rate;
                    totalAmount += parseFloat(tr.getAttribute('data-amount')) || 0;
                    if (tr.getAttribute('data-status') === 'OutOfStock') outStock += 1;
                    else inStock += 1;
                });

                setText('sumAvailValue', formatMoney(availValue));
                setText('sumTotalAmount', formatMoney(totalAmount));
                setText('sumInStock', String(inStock));
                setText('sumOutOfStock', String(outStock));
            }

            function updateFilterInfo(q, want, visibleCount) {
                const box = document.getElementById('filterInfo');
                if (!box) return;

                const filtering = q.length > 0 || want !== 'all';

                if (!filtering) {
                    box.classList.add('d-none');
                    setText('sumScopeAll', 'ALL');
                    setText('sumScopeAll2', 'ALL');
                    return;
                }

                const bits = [];
                if (q.length) bits.push('search "' + q + '"');
                if (want === 'InStock') bits.push('In Stock only');
                if (want === 'OutOfStock') bits.push('Out of Stock only');

                const label = 'FILTERED';
                setText('sumScopeAll', label);
                setText('sumScopeAll2', label);

                box.classList.remove('d-none');
                setText('filterInfoText',
                    bits.join(' + ') + '  ->  ' + visibleCount
                    + ' color(s) match. The totals above show only these results.');
            }

            function buildGroups() {
                if (!table) return [];
                const tbody = table.querySelector('tbody');
                const rows = Array.from(tbody.querySelectorAll('tr'));
                const groups = [];
                let current = null;

                rows.forEach(function (tr) {
                    if (current === null || current.remaining === 0) {
                        // The rowspan lives on the TD, not the TR, so read it from the first cell.
                        const spanCell = tr.querySelector('td[rowspan]');
                        const span = spanCell ? parseInt(spanCell.getAttribute('rowspan'), 10) : 1;
                        current = {
                            tbody: tbody,               // kept so we still have a parent after the holder is detached
                            holder: tr,                 // the row that currently carries the rowspan cells
                            rows: [tr],                 // every row in the group, in original order
                            spanCells: Array.prototype.slice.call(tr.children).slice(0, SPAN_COLS),
                            remaining: (isNaN(span) ? 1 : span) - 1
                        };
                        groups.push(current);
                    } else {
                        current.rows.push(tr);
                        current.remaining = current.remaining - 1;
                    }
                });

                return groups;
            }

            // Restore the group to its original DOM shape before every filter pass.
            // The holder row can be detached during filtering, so always use g.tbody
            // instead of parentNode, otherwise this throws a null reference error.
            function resetGroup(g) {
                const first = g.rows[0];

                if (g.holder === first) {
                    // The holder is the first row, so it must sit before the group's second row.
                    if (g.rows[1] && g.holder.nextSibling !== g.rows[1]) {
                        g.tbody.insertBefore(g.holder, g.rows[1]);
                    }
                } else if (g.holder.nextSibling !== first) {
                    g.tbody.insertBefore(g.holder, first);
                }

                // Put the rowspan cells back on the holder, in the correct order.
                g.spanCells.forEach(function (td) {
                    if (td.parentNode) td.parentNode.removeChild(td);
                });
                g.spanCells.slice().reverse().forEach(function (td) {
                    g.holder.insertBefore(td, g.holder.firstChild);
                });
                g.spanCells.forEach(function (td) { td.setAttribute('rowspan', String(g.rows.length)); });
            }

            function applyFilters() {
                groups.forEach(resetGroup);

                const q = (search.value || '').trim().toLowerCase();
                const want = stockFilter.value;
                let totalVisible = 0;
                const allVisibleRows = [];   // the totals are calculated from these rows

                groups.forEach(function (g) {
                    const visible = g.rows.filter(function (tr) {
                        const hay = (tr.getAttribute('data-search') || '').toLowerCase();
                        const st = tr.getAttribute('data-status') || '';
                        const matchesText = !q || hay.indexOf(q) !== -1;
                        const matchesStock = want === 'all' || st === want;
                        return matchesText && matchesStock;
                    });

                    g.rows.forEach(function (tr) {
                        tr.style.display = visible.indexOf(tr) !== -1 ? '' : 'none';
                    });

                    if (!visible.length) return;
                    totalVisible += visible.length;
                    allVisibleRows.push.apply(allVisibleRows, visible);

                    if (visible[0] === g.holder) {
                        g.spanCells.forEach(function (td) { td.setAttribute('rowspan', String(visible.length)); });
                        return;
                    }

                    // The holder row is being hidden but still carries the rowspan cells.
                    // Move them to the start of the first visible row and detach the now-empty
                    // holder row; resetGroup puts it back before the next filter pass.
                    g.spanCells.forEach(function (td) {
                        if (td.parentNode) td.parentNode.removeChild(td);
                    });
                    // insertBefore(td, firstChild) reverses the order, so iterate in reverse.
                    g.spanCells.slice().reverse().forEach(function (td) {
                        td.setAttribute('rowspan', String(visible.length));
                        visible[0].insertBefore(td, visible[0].firstChild);
                    });
                    if (g.holder.parentNode) g.tbody.removeChild(g.holder);
                });

                const emptyMsg = document.getElementById('fabricEmptyMsg');
                if (emptyMsg) emptyMsg.style.display = totalVisible === 0 ? '' : 'none';

                // Refresh the summary cards from the rows that are still visible.
                updateTotals(allVisibleRows);
                updateFilterInfo(q, want, totalVisible);
            }

            const groups = buildGroups();

            if (table) {
                search.addEventListener('input', applyFilters);
                stockFilter.addEventListener('change', applyFilters);
            }

            document.getElementById('btnClearSearch').addEventListener('click', function () {
                search.value = '';
                stockFilter.value = 'all';
                applyFilters();
            });

            // Edit modal: values come from the hidden <template> tags rendered above.
            document.querySelectorAll('.edit-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const id = btn.getAttribute('data-id');
                    const tpl = document.querySelector('#fabricData template[data-id="' + id + '"]');
                    if (!tpl) return;

                    const d = tpl.dataset;
                    const qty = parseFloat(d.quantity) || 0;
                    const avail = parseFloat(d.available) || 0;
                    const used = qty - avail;

                    document.getElementById('efId').value = d.id;
                    document.getElementById('efTitle').textContent = d.code + ' \u2014 ' + d.color;
                    document.getElementById('efCode').value = d.code;
                    document.getElementById('efColor').value = d.color;
                    document.getElementById('EditFabric_FabricBy').value = d.fabricby || '';
                    document.getElementById('EditFabric_FabricType').value = d.ftype || '';
                    document.getElementById('EditFabric_InvNum').value = d.invnum || '';
                    document.getElementById('EditFabric_FabricDate').value = d.fabricdate || '';
                    document.getElementById('EditFabric_Unit').value = d.unit || 'Meter';
                    document.getElementById('EditFabric_Rate').value = d.rate || '';
                    document.getElementById('EditFabric_Quantity').value = d.quantity || '';

                    document.getElementById('efStockNote').innerHTML =
                        'Total purchased: <strong>' + qty.toFixed(2) + ' ' + d.unit + '</strong> &nbsp;&middot;&nbsp; '
                        + 'Used in articles: <strong>' + (used > 0 ? used.toFixed(2) : '0.00') + ' ' + d.unit + '</strong> &nbsp;&middot;&nbsp; '
                        + 'Currently available: <strong>' + avail.toFixed(2) + ' ' + d.unit + '</strong>'
                        + '<br><span class="text-warning">Quantity cannot be set below '
                        + (used > 0 ? used.toFixed(2) : '0') + ' ' + d.unit + ', which is already used in articles.</span>'
                        + '<br><span class="text-muted">For waste or sales, reduce the Quantity and Available will adjust automatically.</span>';

                    new bootstrap.Modal(document.getElementById('editFabricModal')).show();
                });
            });

            // Top Up modal population
            document.querySelectorAll('.topup-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('tuFabricId').value = btn.getAttribute('data-id');
                    document.getElementById('tuCode').textContent = btn.getAttribute('data-code');
                    document.getElementById('tuAvail').textContent = btn.getAttribute('data-avail') + ' ' + btn.getAttribute('data-unit');
                    document.getElementById('tuRate').textContent = btn.getAttribute('data-rate');
                    new bootstrap.Modal(document.getElementById('topUpModal')).show();
                });
            });

            // Fabric Out modal population
            document.querySelectorAll('.out-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var avail = parseFloat(btn.getAttribute('data-avail')) || 0;
                    var unit = btn.getAttribute('data-unit');

                    document.getElementById('foFabricId').value = btn.getAttribute('data-id');
                    document.getElementById('foCode').textContent = btn.getAttribute('data-code');
                    document.getElementById('foAvail').textContent = avail.toFixed(2) + ' ' + unit;

                    var qtyInput = document.getElementById('foQtyInput');
                    qtyInput.value = '';
                    qtyInput.setAttribute('max', avail);

                    var guardMsg = document.getElementById('foGuardMsg');
                    guardMsg.style.display = 'none';
                    guardMsg.textContent = '';

                    // Client-side guard: qty > available → show warning, disable submit
                    qtyInput.oninput = function () {
                        var val = parseFloat(qtyInput.value) || 0;
                        var submitBtn = document.getElementById('foSubmitBtn');
                        if (val > avail) {
                            guardMsg.textContent = 'Cannot exceed available: ' + avail.toFixed(2) + ' ' + unit;
                            guardMsg.style.display = '';
                            submitBtn.disabled = true;
                        } else {
                            guardMsg.style.display = 'none';
                            submitBtn.disabled = false;
                        }
                    };

                    new bootstrap.Modal(document.getElementById('fabricOutModal')).show();
                });
            });
        })();
    </script>
}
