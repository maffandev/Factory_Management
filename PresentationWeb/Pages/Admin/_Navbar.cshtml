@using Application.DTOs.User
@using Application.Interfaces
@inject IUserService UserService
@{
    var currentUser = User.Identity?.Name ?? "User";
    List<UserResponseDto> users;
    try
    {
        users = (ViewData["Users"] as List<UserResponseDto>) ?? (await UserService.GetAllUsersAsync());
    }
    catch
    {
        users = new List<UserResponseDto>();
    }
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    // Matches if currentPage equals/starts with any of the given page paths (physical paths,
    // not custom routes — ViewContext returns the physical page path e.g. /Admin/FabricForm).
    string IsActive(params string[] pages)
    {
        var match = pages.Any(p =>
            currentPage.Equals(p, System.StringComparison.OrdinalIgnoreCase) ||
            currentPage.StartsWith(p + "/", System.StringComparison.OrdinalIgnoreCase));
        return match ? " active" : "";
    }
}

<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom mb-4">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="/Admin/Dashboard">
            <img src="~/img/logo.png" alt="" class="brand-logo me-2" />
            <span>
                Factory Management
                <small class="d-block text-muted" style="font-size:.7rem;">(SMC-Private) Limited</small>
            </span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar"
                aria-controls="adminNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link@(IsActive("/Admin/Dashboard"))" href="/Admin/Dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link@(IsActive("/Admin/Users"))" href="/Admin/Users">Users</a></li>
                <li class="nav-item"><a class="nav-link@(IsActive("/Admin/ArticleForm"))" href="/Admin/ArticleForm">Add Article</a></li>
                <li class="nav-item"><a class="nav-link@(IsActive("/Admin/FabricForm", "/Admin/Fabrics"))" href="/Admin/Fabrics">Fabrics</a></li>
                <li class="nav-item"><a class="nav-link@(IsActive("/Admin/History"))" href="/Admin/History">History</a></li>
                <li class="nav-item"><a class="nav-link@(IsActive("/Admin/Export"))" href="/Admin/Export">Export</a></li>
            </ul>

            <ul class="navbar-nav align-items-lg-center">
                <!-- Theme toggle -->
                <li class="nav-item dropdown me-2">
                    <a class="nav-link" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" id="themeToggleBtn">
                        <span class="bi bi-circle-half" data-theme-icon></span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><button type="button" class="dropdown-item" data-theme-option="light" onclick="setTheme('light'); return false;"><span class="bi bi-sun me-2"></span>Light</button></li>
                        <li><button type="button" class="dropdown-item" data-theme-option="dark" onclick="setTheme('dark'); return false;"><span class="bi bi-moon-stars me-2"></span>Dark</button></li>
                        <li><button type="button" class="dropdown-item" data-theme-option="system" onclick="setTheme('system'); return false;"><span class="bi bi-circle-half me-2"></span>System</button></li>
                    </ul>
                </li>

                <!-- Switch User (admin impersonation) -->
                <li class="nav-item dropdown me-2">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="bi bi-arrow-left-right me-1"></span>Switch User
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" style="max-height:300px; overflow-y:auto;">
                        @foreach (var u in users
                            .OrderBy(x => x.Role == "Reader" ? 0 : 1)          // Readers first
                            .ThenBy(x => x.DepartmentOrderIndex)                 // department workflow order
                            .ThenBy(x => x.Username))                            // tiebreaker within dept
                        {
                            <li>
                                <form method="post" asp-page="/Admin/Impersonate" asp-route-id="@u.Id" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item @(u.Username == currentUser ? "disabled" : "")">
                                        <span class="bi bi-person me-2"></span>
                                        @u.Username
                                        <span class="text-muted small">(@u.Role · @u.Category)</span>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </li>

                <li class="nav-item dropdown me-2">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="bi bi-person-circle me-1"></span>@currentUser
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#changePasswordModal"><span class="bi bi-key me-2"></span>Change Password</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#logoutModal"><span class="bi bi-box-arrow-right me-2"></span>Logout</button></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Change Password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Change Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="cpStep1">
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <input type="password" class="form-control" id="newPassword" autocomplete="new-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" class="form-control" id="confirmPassword" autocomplete="new-password" />
                    </div>
                </div>
                <div id="cpStep2" class="d-none">
                    <p class="text-muted small mb-2">An OTP has been emailed. Enter it to confirm the new password.</p>
                    <div class="mb-3">
                        <label class="form-label">OTP</label>
                        <input type="text" class="form-control" id="otpInput" inputmode="numeric" maxlength="6" />
                    </div>
                </div>
                <div class="alert alert-danger d-none" id="changePwdError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary d-none" id="cpBackBtn">Back</button>
                <button type="button" class="btn btn-primary" id="cpSendOtpBtn">Send OTP</button>
                <button type="button" class="btn btn-primary d-none" id="cpConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

<!-- Logout Confirmation Modal -->
<div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Logout</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to logout?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page="/Admin/Dashboard" asp-page-handler="Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Logout</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Change Password modal logic — works from every page (posts to /Admin/ChangePassword).
    (function() {
        const cpModalEl = document.getElementById('changePasswordModal');
        if (!cpModalEl) return;

        const cpStep1 = document.getElementById('cpStep1');
        const cpStep2 = document.getElementById('cpStep2');
        const cpSendOtpBtn = document.getElementById('cpSendOtpBtn');
        const cpConfirmBtn = document.getElementById('cpConfirmBtn');
        const cpBackBtn = document.getElementById('cpBackBtn');
        const errEl = document.getElementById('changePwdError');
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        function showErr(msg) { errEl.textContent = msg || 'Something went wrong.'; errEl.classList.remove('d-none'); }
        function hideErr() { errEl.classList.add('d-none'); }

        cpModalEl.addEventListener('show.bs.modal', function() {
            document.getElementById('newPassword').value = '';
            document.getElementById('confirmPassword').value = '';
            document.getElementById('otpInput').value = '';
            hideErr();
            cpStep1.classList.remove('d-none');
            cpStep2.classList.add('d-none');
            cpSendOtpBtn.classList.remove('d-none');
            cpConfirmBtn.classList.add('d-none');
            cpBackBtn.classList.add('d-none');
        });

        cpSendOtpBtn.addEventListener('click', async () => {
            const pwd = document.getElementById('newPassword').value;
            const conf = document.getElementById('confirmPassword').value;
            hideErr();
            if (pwd.length < 6) { showErr('Password must be at least 6 characters.'); return; }
            if (pwd !== conf) { showErr('Passwords do not match.'); return; }

            const res = await fetch('@Url.Page("/Admin/ChangePassword", "SendOtp")', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const data = await res.json();
            if (!data.success) { showErr(data.message); return; }

            cpStep1.classList.add('d-none');
            cpStep2.classList.remove('d-none');
            cpSendOtpBtn.classList.add('d-none');
            cpConfirmBtn.classList.remove('d-none');
            cpBackBtn.classList.remove('d-none');
        });

        cpBackBtn.addEventListener('click', () => {
            cpStep2.classList.add('d-none');
            cpStep1.classList.remove('d-none');
            cpConfirmBtn.classList.add('d-none');
            cpSendOtpBtn.classList.remove('d-none');
            cpBackBtn.classList.add('d-none');
            hideErr();
        });

        cpConfirmBtn.addEventListener('click', async () => {
            const otp = document.getElementById('otpInput').value;
            const pwd = document.getElementById('newPassword').value;
            hideErr();

            const form = new URLSearchParams();
            form.append('otp', otp);
            form.append('newPassword', pwd);

            const res = await fetch('@Url.Page("/Admin/ChangePassword", "ChangePassword")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: form.toString()
            });
            const data = await res.json();
            if (data.success) {
                bootstrap.Modal.getInstance(cpModalEl).hide();
                if (window.showToast) showToast('Password updated successfully.', 'success');
            } else {
                showErr(data.message);
            }
        });
    })();
</script>
