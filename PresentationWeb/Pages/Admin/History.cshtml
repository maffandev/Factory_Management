@page "/Admin/History"
@model HistoryModel

@{
    ViewData["Title"] = "History";
}

@await Html.PartialAsync("_Navbar")
@Html.AntiForgeryToken()

<div class="container-fluid px-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h4 class="mb-0">
            History — Delivered Articles
        </h4>

        <div class="d-flex align-items-center gap-2">
            <div class="btn-group btn-group-sm" role="group" aria-label="Category Quick Filter">
                <button type="button" class="btn btn-primary cat-filter-btn active" data-cat="All">All</button>
                <button type="button" class="btn btn-outline-primary cat-filter-btn" data-cat="Knit">Knit</button>
                <button type="button" class="btn btn-outline-primary cat-filter-btn" data-cat="Woven">Woven</button>
            </div>

            <a asp-page="/Admin/Dashboard"
               class="btn btn-outline-secondary btn-sm">
                <span class="bi bi-arrow-left"></span>
                Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">
                        Search
                    </label>

                    <input type="text"
                           class="form-control"
                           id="historySearch"
                           placeholder="Search by article code or company..."
                           autocomplete="off" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">
                        Delivered From
                    </label>

                    <input type="date"
                           class="form-control"
                           id="historyFrom" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">
                        Delivered To
                    </label>

                    <input type="date"
                           class="form-control"
                           id="historyTo" />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            id="btnResetHistory">
                        Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delivered articles table -->
    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Article Code</th>
                        <th>Category</th>
                        <th>Colour</th>
                        <th>Fabric(s)</th>
                        <th>Qty</th>
                        <th>Delivered</th>
                        <th>Progress</th>
                        <th>Delivery Date</th>
                        <th>Delivered On</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody id="historyBody">
                    <tr>
                        <td colspan="11"
                            class="text-center text-muted py-4">
                            Loading…
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Undo Delivery Confirmation Modal -->
<div class="modal fade"
     id="undoDeliverModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="UndoDeliver">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="undoDeliverId" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        Confirm Undo Delivery
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Are you sure you want to undo delivery?
                    </p>

                    <p class="text-muted small mt-2 mb-0">
                        The latest delivery batch will be reverted, the article will return to In Progress, and the Delivery department will reopen.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-warning">
                        <span class="bi bi-arrow-counterclockwise me-1"></span>
                        Yes, Undo Delivery
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const apiBase =
                '@Url.Page("History", "Articles")';

            const tbody =
                document.getElementById('historyBody');

            const searchInput =
                document.getElementById('historySearch');

            const fromInput =
                document.getElementById('historyFrom');

            const toInput =
                document.getElementById('historyTo');

            let selectedCategory = 'All';

            document.querySelectorAll('.cat-filter-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    selectedCategory = btn.getAttribute('data-cat') || 'All';
                    document.querySelectorAll('.cat-filter-btn').forEach(function (b) {
                        const active = b === btn;
                        b.classList.toggle('active', active);
                        b.classList.toggle('btn-primary', active);
                        b.classList.toggle('btn-outline-primary', !active);
                    });
                    load();
                });
            });

            async function load() {
                const search =
                    searchInput.value.trim();

                const from =
                    fromInput.value;

                const to =
                    toInput.value;

                tbody.innerHTML =
                    '<tr><td colspan="11" class="text-center text-muted py-4">Loading…</td></tr>';

                const url =
                    apiBase +
                    '&search=' +
                    encodeURIComponent(search) +
                    '&category=' +
                    encodeURIComponent(selectedCategory) +
                    '&from=' +
                    encodeURIComponent(from) +
                    '&to=' +
                    encodeURIComponent(to);

                const response =
                    await fetch(url, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                if (!response.ok) {
                    tbody.innerHTML =
                        '<tr><td colspan="11" class="text-center text-danger py-4">Could not load history.</td></tr>';

                    return;
                }

                const rows =
                    await response.json();

                render(rows);
            }

            function render(rows) {
                if (!rows.length) {
                    tbody.innerHTML =
                        '<tr><td colspan="11" class="text-center text-muted py-4">No delivered articles found.</td></tr>';

                    return;
                }

                tbody.innerHTML =
                    rows.map(function (row) {
                        const fabrics =
                            row.fabrics || [];

                        const fabricCell =
                            fabrics.length
                                ? fabrics
                                    .map(function (fabric) {
                                        return escapeHtml(
                                            fabric.fabricCode);
                                    })
                                    .join(', ')
                                : '—';

                        const catBadge = row.category === 'Woven'
                            ? '<span class="badge text-bg-warning text-dark">Woven</span>'
                            : '<span class="badge text-bg-primary">Knit</span>';

                        return `
                            <tr>
                                <td>
                                    ${escapeHtml(row.companyName)}
                                </td>

                                <td class="fw-semibold">
                                    ${escapeHtml(row.articleCode)}
                                </td>

                                <td>
                                    ${catBadge}
                                </td>

                                <td>
                                    ${escapeHtml(row.color)}
                                </td>

                                <td>
                                    ${fabricCell}
                                </td>

                                <td>
                                    ${row.quantity ?? '—'}
                                </td>

                                <td>
                                    <span class="badge text-bg-success">${row.totalDeliveredQuantity ?? 0} pcs</span>
                                </td>

                                <td>
                                    <span class="badge text-bg-info">
                                        ${row.doneDepartments}/${row.totalDepartments}
                                    </span>
                                </td>

                                <td>
                                    ${formatDate(row.deliveryDate)}
                                </td>

                                <td>
                                    ${row.deliveredAt
                                        ? formatDateTime(row.deliveredAt)
                                        : '—'}
                                </td>

                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="/Admin/ArticleDetail/${row.id}">
                                        View
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-warning undo-btn"
                                            data-id="${row.id}">
                                        <span class="bi bi-arrow-counterclockwise"></span>
                                        Undo Deliver
                                    </button>
                                </td>
                            </tr>
                        `;
                    })
                    .join('');

                tbody
                    .querySelectorAll('.undo-btn')
                    .forEach(function (button) {
                        button.addEventListener(
                            'click',
                            function () {
                                openUndoModal(
                                    button.getAttribute('data-id'));
                            });
                    });
            }

            function openUndoModal(articleId) {
                document.getElementById('undoDeliverId').value =
                    articleId;

                new bootstrap.Modal(
                    document.getElementById('undoDeliverModal')
                ).show();
            }

            let debounceTimer;

            searchInput.addEventListener(
                'input',
                function () {
                    clearTimeout(debounceTimer);

                    debounceTimer =
                        setTimeout(load, 350);
                });

            fromInput.addEventListener(
                'change',
                load);

            toInput.addEventListener(
                'change',
                load);

            document
                .getElementById('btnResetHistory')
                .addEventListener(
                    'click',
                    function () {
                        searchInput.value = '';
                        fromInput.value = '';
                        toInput.value = '';
                        selectedCategory = 'All';
                        document.querySelectorAll('.cat-filter-btn').forEach(function (b) {
                            const active = b.getAttribute('data-cat') === 'All';
                            b.classList.toggle('active', active);
                            b.classList.toggle('btn-primary', active);
                            b.classList.toggle('btn-outline-primary', !active);
                        });
                        load();
                    });

            function escapeHtml(value) {
                if (!value) {
                    return '—';
                }

                const div =
                    document.createElement('div');

                div.textContent =
                    String(value);

                return div.innerHTML;
            }

            function formatDate(value) {
                if (!value) {
                    return '—';
                }

                const date =
                    new Date(value);

                return date.toLocaleDateString(
                    'en-GB',
                    {
                        year: 'numeric',
                        month: 'short',
                        day: '2-digit'
                    });
            }

            function formatDateTime(value) {
                if (!value) {
                    return '—';
                }

                const date =
                    new Date(value);

                return date.toLocaleString(
                    'en-US',
                    {
                        day: '2-digit',
                        month: 'short',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        hour12: true
                    });
            }

            load();
        })();
    </script>
}
