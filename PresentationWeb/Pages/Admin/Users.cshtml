@page "/Admin/Users"
@model UsersModel
@{
    ViewData["Title"] = "Users";
}

@await Html.PartialAsync("_Navbar")

<div class="container-fluid px-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Users</h4>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <span class="bi bi-person-plus me-1"></span>Add User
            </button>
            <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm"><span class="bi bi-arrow-left"></span> Back to Dashboard</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            @if (Model.Users.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Category</th>
                            <th>Department</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            var roleBadge = u.Role == "Manager" ? "text-bg-info" : (u.Role == "Reader" ? "text-bg-secondary" : "text-bg-primary");
                            var catBadge = u.Category == "Knit"
                                ? "text-bg-primary"
                                : (u.Category == "Woven" ? "text-bg-warning text-dark" : "text-bg-dark");
                            var teamA = u.TeamNames.ElementAtOrDefault(0) ?? "";
                            var teamB = u.TeamNames.ElementAtOrDefault(1) ?? "";
                            <tr data-username="@u.Username" data-role="@u.Role" data-dept="@(u.DepartmentId?.ToString() ?? "")">
                                <td class="fw-semibold">@u.Username</td>
                                <td><span class="badge @roleBadge">@u.Role</span></td>
                                <td><span class="badge @catBadge">@u.Category</span></td>
                                <td>
                                    @(u.DepartmentName ?? "—")
                                    @if (u.DepartmentId == Model.StitchingDepartmentId && Model.StitchingDepartmentId > 0)
                                    {
                                        if (u.HasSeparateTeams)
                                        {
                                            <div class="small text-muted">
                                                <span class="bi bi-people-fill text-primary me-1"></span>Teams: @string.Join(" / ", u.TeamNames)
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted">
                                                <span class="bi bi-people me-1"></span>Shared Stitching Teams
                                            </div>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Inactive</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-edit-user"
                                            data-id="@u.Id"
                                            data-username="@u.Username"
                                            data-role="@u.Role"
                                            data-dept="@(u.DepartmentId?.ToString() ?? "")"
                                            data-cat="@u.Category"
                                            data-active="@(u.IsActive ? "true" : "false")"
                                            data-has-teams="@(u.HasSeparateTeams ? "true" : "false")"
                                            data-team-a="@teamA"
                                            data-team-b="@teamB">
                                        <span class="bi bi-pencil"></span> Edit
                                    </button>
                                    @if (u.Role != "Admin")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-reset-pwd"
                                                data-id="@u.Id" data-username="@u.Username">
                                            <span class="bi bi-key"></span> Password
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No users found.</p>
            }
        </div>
    </div>

    <!-- Stitching Team Names (per Stitching User) -->
    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <span class="bi bi-people me-1"></span>
            Stitching Team Names (Connected by Stitching User)
        </div>

        <div class="card-body">
            @if (Model.TeamGroups.Any())
            {
                @foreach (var grp in Model.TeamGroups)
                {
                    <form method="post" asp-page-handler="UpdateTeams" class="border rounded p-3 mb-3">
                        @Html.AntiForgeryToken()
                        <div class="fw-semibold mb-2 text-primary">
                            <span class="bi bi-person-badge me-1"></span>Stitching User: @grp.OwnerLabel
                        </div>

                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label small mb-1">Team A Name</label>
                                <input type="hidden" name="teamAId" value="@grp.TeamA.Id" />
                                <input type="text" name="teamAName" class="form-control form-control-sm" value="@grp.TeamA.Name" maxlength="50" required />
                            </div>

                            <div class="col-md-5">
                                <label class="form-label small mb-1">Team B Name</label>
                                <input type="hidden" name="teamBId" value="@grp.TeamB.Id" />
                                <input type="text" name="teamBName" class="form-control form-control-sm" value="@grp.TeamB.Name" maxlength="50" required />
                            </div>

                            <div class="col-md-2 d-grid">
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <span class="bi bi-check-lg me-1"></span>Save Teams
                                </button>
                            </div>
                        </div>
                    </form>
                }
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Stitching Team A and Team B are not configured yet.
                </div>
            }
        </div>
    </div>
</div>

<!-- Create User modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateUser">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add New User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Username <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="createUsername" name="username" required minlength="3" maxlength="50" placeholder="e.g. stitching_woven" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" name="password" required minlength="4" autocomplete="new-password" placeholder="At least 4 characters" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role <span class="text-danger">*</span></label>
                        <select class="form-select" id="createRole" name="role" required>
                            <option value="Manager" selected>Manager</option>
                            <option value="Reader">Reader</option>
                        </select>
                    </div>
                    <div class="mb-3" id="createDeptWrap">
                        <label class="form-label">Department <span class="text-danger">*</span></label>
                        <select class="form-select" id="createDepartment" name="departmentId">
                            <option value="">— Select Department —</option>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Article Category Access <span class="text-danger">*</span></label>
                        <select class="form-select" name="category" required>
                            <option value="Both" selected>Both (Knit &amp; Woven)</option>
                            <option value="Knit">Knit Only</option>
                            <option value="Woven">Woven Only</option>
                        </select>
                    </div>

                    <!-- Stitching Teams Option (shown when Department == Stitching) -->
                    <div class="border rounded p-3 bg-body-tertiary d-none" id="createStitchingTeamsWrap">
                        <label class="form-label fw-semibold mb-1">
                            <span class="bi bi-people-fill text-primary me-1"></span>Create Separate Teams for this Stitching User?
                        </label>
                        <div class="form-text small mb-2">
                            Select <strong>Yes</strong> to give this Stitching user their own 2 dedicated teams, or <strong>No</strong> to share the existing Stitching teams.
                        </div>
                        <div class="btn-group w-100 mb-2" role="group">
                            <input type="radio" class="btn-check" name="createSeparateTeams" id="createSepTeamsYes" value="true" checked />
                            <label class="btn btn-outline-primary btn-sm" for="createSepTeamsYes">Yes (Create Separate 2 Teams)</label>
                            <input type="radio" class="btn-check" name="createSeparateTeams" id="createSepTeamsNo" value="false" />
                            <label class="btn btn-outline-secondary btn-sm" for="createSepTeamsNo">No (Use Existing Teams)</label>
                        </div>
                        <div class="row g-2 mt-1" id="createCustomTeamNamesWrap">
                            <div class="col-6">
                                <label class="form-label small mb-1">Team A Name</label>
                                <input type="text" class="form-control form-control-sm" id="createTeamAName" name="teamAName" maxlength="50" placeholder="e.g. Team A" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1">Team B Name</label>
                                <input type="text" class="form-control form-control-sm" id="createTeamBName" name="teamBName" maxlength="50" placeholder="e.g. Team B" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><span class="bi bi-check-lg me-1"></span>Create User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="UpdateUser">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editUserId" name="id" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input type="text" class="form-control" id="editUsername" name="newUsername" required minlength="3" maxlength="50" />
                    </div>
                    <div class="mb-3" id="editDeptWrap">
                        <label class="form-label">Department</label>
                        <select class="form-select" id="editDepartment" name="newDepartmentId">
                            <option value="">— None —</option>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3" id="editCategoryWrap">
                        <label class="form-label">Article Category Access</label>
                        <select class="form-select" id="editCategory" name="newCategory">
                            <option value="Both">Both (Knit &amp; Woven)</option>
                            <option value="Knit">Knit Only</option>
                            <option value="Woven">Woven Only</option>
                        </select>
                    </div>
                    <div class="mb-3" id="editActiveWrap">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="editIsActive" name="isActive">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>

                    <!-- Stitching Teams Option in Edit Modal -->
                    <div class="border rounded p-3 bg-body-tertiary d-none" id="editStitchingTeamsWrap">
                        <label class="form-label fw-semibold mb-1">
                            <span class="bi bi-people-fill text-primary me-1"></span>Separate Teams for this Stitching User?
                        </label>
                        <div class="btn-group w-100 mb-2" role="group">
                            <input type="radio" class="btn-check" name="createSeparateTeams" id="editSepTeamsYes" value="true" />
                            <label class="btn btn-outline-primary btn-sm" for="editSepTeamsYes">Yes (Dedicated 2 Teams)</label>
                            <input type="radio" class="btn-check" name="createSeparateTeams" id="editSepTeamsNo" value="false" />
                            <label class="btn btn-outline-secondary btn-sm" for="editSepTeamsNo">No (Use Shared Teams)</label>
                        </div>
                        <div class="row g-2 mt-1" id="editCustomTeamNamesWrap">
                            <div class="col-6">
                                <label class="form-label small mb-1">Team A Name</label>
                                <input type="text" class="form-control form-control-sm" id="editTeamAName" name="teamAName" maxlength="50" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1">Team B Name</label>
                                <input type="text" class="form-control form-control-sm" id="editTeamBName" name="teamBName" maxlength="50" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reset Password modal -->
<div class="modal fade" id="resetPwdModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ResetPassword">
                @Html.AntiForgeryToken()
                <input type="hidden" id="resetUserId" name="id" />
                <div class="modal-header">
                    <h5 class="modal-title">Reset Password — <span id="resetUsername"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <input type="password" class="form-control" name="newPassword" required minlength="4" autocomplete="new-password" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const stitchingDeptId = '@Model.StitchingDepartmentId';
            const createRole = document.getElementById('createRole');
            const createDeptWrap = document.getElementById('createDeptWrap');
            const createDepartment = document.getElementById('createDepartment');
            const createStitchingTeamsWrap = document.getElementById('createStitchingTeamsWrap');
            const createSepTeamsYes = document.getElementById('createSepTeamsYes');
            const createSepTeamsNo = document.getElementById('createSepTeamsNo');
            const createCustomTeamNamesWrap = document.getElementById('createCustomTeamNamesWrap');
            const createUsername = document.getElementById('createUsername');
            const createTeamAName = document.getElementById('createTeamAName');
            const createTeamBName = document.getElementById('createTeamBName');

            function syncCreateModal() {
                const isMgr = createRole.value === 'Manager';
                createDeptWrap.classList.toggle('d-none', !isMgr);
                createDepartment.required = isMgr;

                const isStitching = isMgr && createDepartment.value === stitchingDeptId && stitchingDeptId !== '0';
                createStitchingTeamsWrap.classList.toggle('d-none', !isStitching);
                createCustomTeamNamesWrap.classList.toggle('d-none', !createSepTeamsYes.checked);
            }

            createRole.addEventListener('change', syncCreateModal);
            createDepartment.addEventListener('change', function() {
                syncCreateModal();
                const uname = createUsername.value.trim();
                if (createDepartment.value === stitchingDeptId && !createTeamAName.value) {
                    createTeamAName.value = uname ? (uname + ' - Team A') : 'Team A';
                    createTeamBName.value = uname ? (uname + ' - Team B') : 'Team B';
                }
            });
            createUsername.addEventListener('input', function() {
                const uname = createUsername.value.trim();
                if (createDepartment.value === stitchingDeptId) {
                    createTeamAName.placeholder = uname ? (uname + ' - Team A') : 'Team A';
                    createTeamBName.placeholder = uname ? (uname + ' - Team B') : 'Team B';
                }
            });
            createSepTeamsYes.addEventListener('change', syncCreateModal);
            createSepTeamsNo.addEventListener('change', syncCreateModal);
            syncCreateModal();

            // Edit user modal
            const editDepartment = document.getElementById('editDepartment');
            const editStitchingTeamsWrap = document.getElementById('editStitchingTeamsWrap');
            const editSepTeamsYes = document.getElementById('editSepTeamsYes');
            const editSepTeamsNo = document.getElementById('editSepTeamsNo');
            const editCustomTeamNamesWrap = document.getElementById('editCustomTeamNamesWrap');
            const editTeamAName = document.getElementById('editTeamAName');
            const editTeamBName = document.getElementById('editTeamBName');
            let currentEditRole = '';

            function syncEditStitchingTeams() {
                const isStitching = currentEditRole === 'Manager' && editDepartment.value === stitchingDeptId && stitchingDeptId !== '0';
                editStitchingTeamsWrap.classList.toggle('d-none', !isStitching);
                editCustomTeamNamesWrap.classList.toggle('d-none', !editSepTeamsYes.checked);
            }

            editDepartment.addEventListener('change', syncEditStitchingTeams);
            editSepTeamsYes.addEventListener('change', syncEditStitchingTeams);
            editSepTeamsNo.addEventListener('change', syncEditStitchingTeams);

            document.querySelectorAll('.btn-edit-user').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    currentEditRole = btn.getAttribute('data-role') || '';
                    const uname = btn.getAttribute('data-username') || '';
                    document.getElementById('editUserId').value = btn.getAttribute('data-id');
                    document.getElementById('editUsername').value = uname;
                    editDepartment.value = btn.getAttribute('data-dept') || '';
                    document.getElementById('editCategory').value = btn.getAttribute('data-cat') || 'Both';
                    document.getElementById('editIsActive').value = btn.getAttribute('data-active') || 'true';

                    const hasTeams = btn.getAttribute('data-has-teams') === 'true';
                    editSepTeamsYes.checked = hasTeams;
                    editSepTeamsNo.checked = !hasTeams;
                    editTeamAName.value = btn.getAttribute('data-team-a') || (uname + ' - Team A');
                    editTeamBName.value = btn.getAttribute('data-team-b') || (uname + ' - Team B');

                    const isAdmin = currentEditRole === 'Admin';
                    const isMgr = currentEditRole === 'Manager';
                    document.getElementById('editDeptWrap').classList.toggle('d-none', !isMgr);
                    document.getElementById('editCategoryWrap').classList.toggle('d-none', isAdmin);
                    document.getElementById('editActiveWrap').classList.toggle('d-none', isAdmin);

                    syncEditStitchingTeams();

                    new bootstrap.Modal(document.getElementById('editUserModal')).show();
                });
            });

            // Reset password
            document.querySelectorAll('.btn-reset-pwd').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    document.getElementById('resetUserId').value = btn.getAttribute('data-id');
                    document.getElementById('resetUsername').textContent = btn.getAttribute('data-username');
                    const pwdInput = document.querySelector('#resetPwdModal input[name="newPassword"]');
                    pwdInput.value = '';
                    new bootstrap.Modal(document.getElementById('resetPwdModal')).show();
                });
            });
        })();
    </script>
}
