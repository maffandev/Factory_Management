@page "/Admin/ArticleDetail/{id:int}"
@model ArticleDetailModel

@{
    ViewData["Title"] = "Article Detail";
    var a = Model.Article!;

    var totalLoss = Model.DepartmentStatuses
        .Sum(d => d.LossQuantity ?? 0);

    var catBadge = a.Category == "Woven" ? "text-bg-warning text-dark" : "text-bg-primary";
}

@await Html.PartialAsync("_Navbar")

<div class="container-fluid px-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h4 class="mb-0">
            Article @a.ArticleCode
            <span class="badge @catBadge fs-6 ms-2">@a.Category</span>
        </h4>

        <div class="d-flex flex-wrap gap-2">
            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#sizeTableModal">
                <span class="bi bi-table me-1"></span>
                Show Size Table
            </button>

            <button type="button"
                    class="btn btn-outline-success btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#deliveryTableModal">
                <span class="bi bi-truck me-1"></span>
                Show Delivery Table
            </button>

            @if (Model.CanUndo)
            {
                <button type="button"
                        class="btn btn-warning btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#undoLastStepModal">
                    <span class="bi bi-arrow-counterclockwise"></span>
                    Undo One Step
                </button>
            }

            <a asp-page="/Admin/ArticleEdit"
               asp-route-id="@a.Id"
               class="btn btn-primary btn-sm">
                <span class="bi bi-pencil"></span>
                Edit
            </a>

            <a asp-page="/Admin/Dashboard"
               class="btn btn-outline-secondary btn-sm">
                <span class="bi bi-arrow-left"></span>
                Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (a.IsDepartmentDelayed)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-danger border-start border-4 py-1 px-3 mb-2 small" role="alert">
            <span class="bi bi-exclamation-triangle-fill me-1"></span>
            <strong>Delay (&gt; 3 Days):</strong>
            <strong>@(a.CurrentDepartmentName ?? "Department")</strong> (@a.CurrentDepartmentStatus) — <strong>@a.CurrentDepartmentDays days</strong>
            <button type="button" class="btn-close py-2" style="font-size:0.65rem;" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3">

        <!-- Article information -->
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Article Information</span>

                    <div>
                        @if (a.IsPinned)
                        {
                            <span class="badge text-bg-warning">
                                <span class="bi bi-pin-fill"></span>
                                Pinned
                            </span>
                        }

                        @if (a.IsDelivered)
                        {
                            <span class="badge text-bg-success">
                                Delivered
                            </span>
                        }
                        else if (a.TotalDeliveredQuantity > 0)
                        {
                            <span class="badge text-bg-info">
                                Partial Delivery (@a.TotalDeliveredQuantity / @a.TotalDeliverableQuantity pcs)
                            </span>
                        }
                    </div>
                </div>

                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <th style="width:40%;">Company</th>
                                <td>@a.CompanyName</td>
                            </tr>

                            <tr>
                                <th>Article Code</th>
                                <td>@a.ArticleCode</td>
                            </tr>

                            <tr>
                                <th>Category</th>
                                <td><span class="badge @catBadge">@a.Category</span></td>
                            </tr>

                            <tr>
                                <th>Colour</th>
                                <td>@(a.Color ?? "—")</td>
                            </tr>

                            <tr>
                                <th>Order Date</th>
                                <td>@a.OrderDate.ToString("dd MMM yyyy")</td>
                            </tr>

                            <tr>
                                <th>Delivery Date</th>
                                <td>@a.DeliveryDate.ToString("dd MMM yyyy")</td>
                            </tr>

                            <tr>
                                <th>Season</th>
                                <td>@(a.Season ?? "—")</td>
                            </tr>

                            <tr>
                                <th>Quantity</th>
                                <td>@(a.Quantity?.ToString() ?? "—")</td>
                            </tr>

                            <tr>
                                <th>Delivered / Remaining</th>
                                <td>
                                    @if (a.TotalDeliverableQuantity > 0)
                                    {
                                        <span class="badge text-bg-success me-1">Delivered: @a.TotalDeliveredQuantity pcs</span>
                                        <span class="badge text-bg-secondary">Remaining: @a.RemainingDeliverableQuantity pcs</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>

                            <tr>
                                <th>Total Loss</th>
                                <td>
                                    <span class="badge text-bg-danger">
                                        @totalLoss pieces
                                    </span>
                                </td>
                            </tr>

                            <tr>
                                <th>Stitching</th>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(a.AssignedTeamName))
                                    {
                                        <span>@a.AssignedTeamName</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(a.StitchedBy))
                                    {
                                        <span>
                                            — Done by: @a.StitchedBy
                                        </span>
                                    }
                                </td>
                            </tr>

                            <tr>
                                <th>Price / Piece</th>
                                <td>
                                    @(a.PricePerPiece?.ToString("N2") ?? "—")
                                </td>
                            </tr>

                            <tr>
                                <th>Total Price</th>
                                <td>
                                    @(a.PriceTotal?.ToString("N2") ?? "—")
                                </td>
                            </tr>

                            <tr>
                                <th>Created By</th>
                                <td>
                                    @a.CreatedByUsername
                                    (@a.CreatedAt.ToString("dd MMM yyyy hh:mm tt"))
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    @if (a.AlternateCodes.Any())
                    {
                        <h6 class="mt-3 mb-1">
                            Alternate Codes
                        </h6>

                        <div>
                            @foreach (var c in a.AlternateCodes)
                            {
                                <span class="badge text-bg-secondary me-1">
                                    @c
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Embellishments and progress -->
        <div class="col-lg-5">
            <div class="card shadow-sm mb-3">
                <div class="card-header">
                    Embellishments
                </div>

                <div class="card-body">
                    <span class="badge @(a.EmbellishmentPrinting
                        ? "text-bg-success"
                        : "text-bg-light text-dark border") me-1">
                        Printing
                    </span>

                    <span class="badge @(a.EmbellishmentEmbroidery
                        ? "text-bg-success"
                        : "text-bg-light text-dark border") me-1">
                        Embroidery
                    </span>

                    <span class="badge @(a.EmbellishmentHandwork
                        ? "text-bg-success"
                        : "text-bg-light text-dark border")">
                        Hand Work
                    </span>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    Production &amp; Delivery Progress
                </div>

                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fs-4 fw-bold">
                            @a.DoneDepartments / @a.TotalDepartments
                        </span>

                        <span class="text-muted small">
                            departments done
                        </span>
                    </div>

                    @{
                        var pct = a.TotalDepartments > 0
                            ? (int)Math.Round(
                                (double)a.DoneDepartments /
                                a.TotalDepartments * 100)
                            : 0;
                    }

                    <div class="progress mb-3" style="height:20px;">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width:@(pct)%;"
                             aria-valuenow="@pct"
                             aria-valuemin="0"
                             aria-valuemax="100">
                            @pct%
                        </div>
                    </div>

                    @if (a.TotalDeliverableQuantity > 0)
                    {
                        var delPct = (int)Math.Round((double)a.TotalDeliveredQuantity / a.TotalDeliverableQuantity * 100);
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="fw-semibold small">Pieces Delivered</span>
                            <span class="small text-muted">@a.TotalDeliveredQuantity / @a.TotalDeliverableQuantity pcs (@a.RemainingDeliverableQuantity left)</span>
                        </div>
                        <div class="progress mb-3" style="height:16px;">
                            <div class="progress-bar bg-success"
                                 role="progressbar"
                                 style="width:@(delPct)%;"
                                 aria-valuenow="@delPct"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                @delPct%
                            </div>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="button"
                                class="btn btn-outline-primary btn-sm flex-grow-1"
                                data-bs-toggle="modal"
                                data-bs-target="#sizeTableModal">
                            <span class="bi bi-table me-1"></span>
                            Show Size Table
                        </button>
                        <button type="button"
                                class="btn btn-outline-success btn-sm flex-grow-1"
                                data-bs-toggle="modal"
                                data-bs-target="#deliveryTableModal">
                            <span class="bi bi-truck me-1"></span>
                            Show Delivery Table
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fabrics -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    Linked Fabrics
                </div>

                <div class="card-body table-responsive">
                    @if (a.Fabrics.Any())
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Type</th>
                                    <th>Colour</th>
                                    <th>Invoice</th>
                                    <th>Used Qty</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var f in a.Fabrics)
                                {
                                    <tr>
                                        <td>@f.FabricCode</td>
                                        <td>@f.FabricType</td>
                                        <td>@f.Color</td>
                                        <td>@f.InvNum</td>
                                        <td>@f.QuantityUsed @f.Unit</td>
                                        <td>
                                            @if (f.Status == "OutOfStock")
                                            {
                                                <span class="badge text-bg-danger">
                                                    Out Of Stock
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-success">
                                                    In Stock
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No fabrics linked to this article.
                        </p>
                    }
                </div>
            </div>
        </div>

        <!-- Department workflow -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    Department Flow &amp; Status
                </div>

                <div class="card-body table-responsive">
                    @if (Model.DepartmentStatuses.Any())
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Seq</th>
                                    <th>Department</th>
                                    <th>Status</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th>Duration</th>
                                    <th>Input</th>
                                    <th>Output</th>
                                    <th>Loss</th>
                                    <th>Note</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var d in Model.DepartmentStatuses)
                                {
                                    var badge = d.Status switch
                                    {
                                        "Done" => "text-bg-success",
                                        "InProcess" => "text-bg-warning",
                                        _ => "text-bg-secondary"
                                    };

                                    <tr class="@(d.IsDelayed ? "table-danger border-start border-danger border-4" : "")">
                                        <td>
                                            <span class="badge text-bg-dark">
                                                @d.SequenceNumber
                                            </span>
                                        </td>

                                        <td class="fw-semibold">
                                            @if (string.Equals(
                                                d.DepartmentName,
                                                "Stitching",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div>
                                                    Stitching
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(
                                                    a.AssignedTeamName))
                                                {
                                                    <div class="small text-primary">
                                                        <span class="bi bi-people me-1"></span>
                                                        @a.AssignedTeamName
                                                    </div>
                                                }

                                                @if (d.Status == "Done" &&
                                                    !string.IsNullOrWhiteSpace(
                                                        a.StitchedBy))
                                                {
                                                    <div class="small text-success">
                                                        <span class="bi bi-person-check me-1"></span>
                                                        Done by: @a.StitchedBy
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                @d.DepartmentName
                                                @if (string.Equals(d.DepartmentName, "Sampling", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="small text-primary">Sampling Attempts: @d.SamplingAttemptCount</div>
                                                    @if (!string.IsNullOrWhiteSpace(d.SamplingApprovalState))
                                                    { <div class="small text-muted">@d.SamplingApprovalState</div> }
                                                }
                                            }
                                        <td>
                                            <span class="badge @badge">
                                                @d.Status
                                            </span>
                                            @if (d.IsDelayed)
                                            {
                                                <span class="badge text-bg-danger ms-1" title="Delayed (@d.ElapsedDays days)">
                                                    <span class="bi bi-exclamation-triangle-fill me-1"></span>@d.ElapsedDays d
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @(d.StartedAt?.ToString(
                                                "dd MMM yyyy hh:mm tt") ?? "—")
                                        </td>

                                        <td>
                                            @(d.EndedAt?.ToString(
                                                "dd MMM yyyy hh:mm tt") ?? "—")
                                        </td>

                                        <td>
                                            @(d.DurationDisplay ?? "—")
                                        </td>

                                        <td>
                                            @(d.InputQuantity?.ToString() ?? "—")
                                        </td>

                                        <td>
                                            @(d.OutputQuantity?.ToString() ?? "—")
                                        </td>

                                        <td>
                                            @if (string.Equals(
                                                d.DepartmentName,
                                                "Delivery",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge text-bg-danger">
                                                    @totalLoss pieces
                                                </span>

                                                <div class="small text-muted">
                                                    Total Article Loss
                                                </div>
                                            }
                                            else
                                            {
                                                @(d.LossQuantity?.ToString() ?? "—")
                                            }
                                        </td>

                                        <td>
                                            @(d.Note ?? "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No department workflow defined for this article.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Size Table Modal -->
<div class="modal fade" id="sizeTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span class="bi bi-table me-1"></span>Size Table — @a.ArticleCode
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (a.CuttingSizeBreakdowns.Any() || a.SizeBreakdowns.Any() || a.BGradeQuantity.HasValue)
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Size</th>
                                    <th>Cutting Qty</th>
                                    <th>A-Grade Qty</th>
                                    <th>Cut → A-Grade Diff</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cut in a.CuttingSizeBreakdowns.OrderBy(x => x.OrderIndex))
                                {
                                    var quality = a.SizeBreakdowns.FirstOrDefault(x => x.SizeLabel.Equals(cut.SizeLabel, StringComparison.OrdinalIgnoreCase));
                                    var aq = quality?.Quantity ?? 0;
                                    <tr>
                                        <td class="fw-semibold">@cut.SizeLabel</td>
                                        <td>@cut.Quantity</td>
                                        <td>@aq</td>
                                        <td>@(cut.Quantity - aq)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr><th>Cutting Total</th><th colspan="3">@a.CuttingSizeTotal</th></tr>
                                <tr><th>Loss Before Quality</th><th colspan="3">@a.PreQualityLossQuantity</th></tr>
                                <tr><th>Total A-Grade</th><th colspan="3">@a.AGradeQuantity</th></tr>
                                <tr><th>B-Grade</th><th colspan="3">@(a.BGradeQuantity ?? 0)</th></tr>
                                <tr class="table-warning"><th>C-Grade / Quality Loss</th><th colspan="3">@a.CGradeQuantity</th></tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No size breakdown has been entered for this article yet.</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delivery Table Modal -->
<div class="modal fade" id="deliveryTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span class="bi bi-truck me-1"></span>Delivery Table — @a.ArticleCode
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (a.SizeBreakdowns.Any() || a.BGradeQuantity.HasValue || a.DeliveryBatches.Any())
                {
                    <div class="d-flex flex-wrap justify-content-between alert alert-info py-2 mb-3 small">
                        <div>
                            <strong>Total Deliverable:</strong> @a.TotalDeliverableQuantity pcs ·
                            <strong>Delivered:</strong> @a.TotalDeliveredQuantity pcs ·
                            <strong>Remaining:</strong> @a.RemainingDeliverableQuantity pcs
                        </div>
                        <div>
                            <strong>Packed By:</strong> @(a.PackedBy ?? "—") ·
                            <strong>Checked By:</strong> @(a.CheckedBy ?? "—") ·
                            <strong>Cartons:</strong> @(a.NoOfCartons?.ToString() ?? "—")
                        </div>
                    </div>

                    <h6 class="small fw-semibold text-muted mb-2">Size-Wise Delivery Status</h6>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Size</th>
                                    <th>A-Grade Total</th>
                                    <th>Delivered Qty</th>
                                    <th>Remaining To Deliver</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sb in a.SizeBreakdowns.OrderBy(x => x.OrderIndex))
                                {
                                    var rem = Math.Max(0, sb.Quantity - sb.DeliveredQuantity);
                                    <tr>
                                        <td class="fw-semibold">@sb.SizeLabel</td>
                                        <td>@sb.Quantity</td>
                                        <td class="text-success fw-semibold">@sb.DeliveredQuantity</td>
                                        <td class="@(rem > 0 ? "text-warning fw-semibold" : "text-muted")">@rem</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Total A-Grade</th>
                                    <th>@a.AGradeQuantity</th>
                                    <th class="text-success">@a.DeliveredAGradeQuantity</th>
                                    <th>@(Math.Max(0, a.AGradeQuantity - a.DeliveredAGradeQuantity))</th>
                                </tr>
                                <tr>
                                    <th>B-Grade</th>
                                    <th>@(a.BGradeQuantity ?? 0)</th>
                                    <th class="text-success">@a.DeliveredBGradeQuantity</th>
                                    <th>@(Math.Max(0, (a.BGradeQuantity ?? 0) - a.DeliveredBGradeQuantity))</th>
                                </tr>
                                <tr class="table-info">
                                    <th>Grand Total</th>
                                    <th>@a.TotalDeliverableQuantity</th>
                                    <th class="text-success">@a.TotalDeliveredQuantity</th>
                                    <th>@a.RemainingDeliverableQuantity</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <h6 class="small fw-semibold text-muted mb-2">Delivery Batches</h6>
                    @if (a.DeliveryBatches.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Batch</th>
                                        <th>Delivered At</th>
                                        <th>Sizes Delivered</th>
                                        <th>B-Grade</th>
                                        <th>Total Pcs</th>
                                        <th>Packed By</th>
                                        <th>Checked By</th>
                                        <th>Cartons</th>
                                        <th>Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in a.DeliveryBatches)
                                    {
                                        var sizeText = b.Items.Any()
                                            ? string.Join(", ", b.Items.Select(i => $"{i.SizeLabel}: {i.QuantityDelivered}"))
                                            : "—";
                                        <tr>
                                            <td><span class="badge text-bg-dark">#@b.BatchNumber</span></td>
                                            <td>@b.DeliveredAt.ToString("dd MMM yyyy hh:mm tt")</td>
                                            <td>@sizeText</td>
                                            <td>@b.BGradeDelivered</td>
                                            <td><span class="badge text-bg-success">@b.TotalDeliveredInBatch pcs</span></td>
                                            <td>@(b.PackedBy ?? "—")</td>
                                            <td>@(b.CheckedBy ?? "—")</td>
                                            <td>@(b.NoOfCartons?.ToString() ?? "—")</td>
                                            <td>@(b.Note ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No delivery batches recorded yet.</p>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No delivery data available for this article yet.</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Undo One Step confirmation modal -->
<div class="modal fade"
     id="undoLastStepModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="UndoLast"
                  asp-route-id="@a.Id">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">
                        Confirm Undo
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Are you sure you want to undo the last step?
                    </p>

                    <p class="text-muted small mt-2 mb-0">
                        This will move the current department (or latest partial delivery batch) one step back.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-warning">
                        <span class="bi bi-arrow-counterclockwise me-1"></span>
                        Yes, Undo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
