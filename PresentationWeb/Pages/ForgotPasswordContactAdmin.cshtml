@page
@{
    Layout = "_Layout";
    ViewData["Title"] = "Contact Admin";
}

<div class="login-wrapper">
    <div class="card login-card shadow-sm login-card-animate">
        <div class="card-body p-4 text-center">
            <i class="bi bi-shield-exclamation text-warning" style="font-size: 2.5rem;"></i>
            <h4 class="card-title mt-3 mb-2">Contact Admin</h4>
            <p class="text-muted mb-4">Only Admin accounts can self-reset their password. Please contact your Admin to reset your password.</p>
            <a asp-page="/Login" class="btn btn-primary w-100">Back to Login</a>
        </div>
    </div>
</div>