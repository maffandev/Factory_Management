@page
@model PresentationWeb.Pages.ForgotPasswordOtpModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Verify OTP";
}

<div class="login-wrapper">
    <div class="card login-card shadow-sm login-card-animate">
        <div class="card-body p-4">
            <h4 class="card-title mb-1 text-center">Verify OTP</h4>
            <p class="text-muted text-center mb-4">Enter the code sent to the admin email</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2" role="alert">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">OTP Code</label>
                    <input asp-for="OtpCode" class="form-control" maxlength="6" required autofocus />
                    <span asp-validation-for="OtpCode" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Reset Password</button>
            </form>

            <div class="text-center mt-3">
                <a asp-page="/Login" class="small">Back to login</a>
            </div>
        </div>
    </div>
</div>