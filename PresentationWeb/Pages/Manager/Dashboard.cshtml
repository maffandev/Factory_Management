@section Scripts {
    <script>
        (function () {
            const articleDetails =
                @Html.Raw(articleDetailsJson);

            const currentStatuses =
                @Html.Raw(statusesJson);

            const lossBreakdown =
                @Html.Raw(lossBreakdownJson);

            const SIZES = [
                "0-3 M",
                "3-6 M",
                "6-9 M",
                "9-12 M",
                "12-18 M",
                "18-24 M",
                "1-2 Y",
                "2-3 Y",
                "3-4 Y",
                "4-5 Y",
                "5-6 Y",
                "6-7 Y",
                "7-8 Y",
                "9-10 Y",
                "11-12 Y",
                "13-14 Y"
            ];

            // Category Quick Filter for 'Both' Manager
            let activeCategory = "All";

            function applyManagerFilters() {
                const q = (document.getElementById("mgrSearchInput")?.value || "").trim().toLowerCase();
                let visibleCount = 0;

                document.querySelectorAll(".cat-filterable-row").forEach(function(tr) {
                    const rowCat = tr.getAttribute("data-category") || "Knit";
                    const catMatch = activeCategory === "All" || rowCat.toLowerCase() === activeCategory.toLowerCase();
                    const textMatch = !q || tr.textContent.toLowerCase().includes(q);
                    const show = catMatch && textMatch;

                    tr.classList.toggle("d-none", !show);
                    if (show) visibleCount++;
                });

                const emptyEl = document.getElementById("noCatMatchMsg");
                if (emptyEl) {
                    emptyEl.classList.toggle("d-none", visibleCount > 0);
                }
            }

            document.getElementById("mgrSearchInput")?.addEventListener("input", applyManagerFilters);

            document.querySelectorAll(".cat-filter-btn").forEach(function(btn) {
                btn.addEventListener("click", function() {
                    activeCategory = btn.getAttribute("data-cat") || "All";
                    document.querySelectorAll(".cat-filter-btn").forEach(function(b) {
                        const active = b === btn;
                        b.classList.toggle("active", active);
                        b.classList.toggle("btn-primary", active);
                        b.classList.toggle("btn-outline-primary", !active);
                    });
                    applyManagerFilters();
                });
            });
            document.querySelectorAll(".cat-filter-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const cat = btn.getAttribute("data-cat") || "All";
                    document.querySelectorAll(".cat-filter-btn").forEach(function (b) {
                        const active = b === btn;
                        b.classList.toggle("active", active);
                        b.classList.toggle("btn-primary", active);
                        b.classList.toggle("btn-outline-primary", !active);
                    });

                    let visibleCount = 0;
                    document.querySelectorAll(".cat-filterable-row").forEach(function (tr) {
                        const rowCat = tr.getAttribute("data-category") || "Knit";
                        const show = cat === "All" || rowCat.toLowerCase() === cat.toLowerCase();
                        tr.classList.toggle("d-none", !show);
                        if (show) visibleCount++;
                    });

                    const emptyEl = document.getElementById("noCatMatchMsg");
                    if (emptyEl) {
                        emptyEl.classList.toggle("d-none", visibleCount > 0);
                    }
                });
            });

            function getArticleDetails(articleId) {
                return articleDetails[String(articleId)]
                    || articleDetails[articleId]
                    || null;
            }

            function escapeHtml(value) {
                const div = document.createElement("div");
                div.textContent = value ?? "";
                return div.innerHTML;
            }

            // Cutting uses the fixed-size table.
            const cuttingRows = document.getElementById("cuttingSizeRows");
            if (cuttingRows) {
                SIZES.forEach(function (size) {
                    const row = document.createElement("tr");
                    row.innerHTML = "<td class=\"fw-semibold\">" + escapeHtml(size) +
                        "</td><td><input type=\"text\" class=\"form-control form-control-sm cutting-size-qty\" data-size=\"" +
                        escapeHtml(size) + "\" inputmode=\"numeric\" pattern=\"[0-9]*\" /></td>";
                    row.querySelector("input").addEventListener("input", function () {
                        this.value = this.value.replace(/[^0-9]/g, "");
                        document.getElementById("cuttingGrandTotal").textContent =
                            Array.from(document.querySelectorAll(".cutting-size-qty")).reduce((t, x) => t + (Number(x.value) || 0), 0);
                    });
                    cuttingRows.appendChild(row);
                });
                document.getElementById("endWorkForm").addEventListener("submit", function () {
                    const fields = Array.from(document.querySelectorAll(".cutting-size-qty"));
                    document.getElementById("cuttingSizeLabels").value = fields.map(x => x.dataset.size).join("|");
                    document.getElementById("cuttingQuantities").value = fields.map(x => x.value || "0").join("|");
                });
            }

            // Generic Start
            document
                .querySelectorAll(".btn-start")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        document.getElementById("startStatusId").value =
                            button.getAttribute("data-id");

                        new bootstrap.Modal(
                            document.getElementById("startModal")
                        ).show();
                    });
                });

            // Stitching Start
            document
                .querySelectorAll(".btn-start-team")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        document.getElementById("startTeamStatusId").value =
                            button.getAttribute("data-id");

                        new bootstrap.Modal(
                            document.getElementById("startTeamModal")
                        ).show();
                    });
                });

            // Generic End
            document
                .querySelectorAll(".btn-end")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const statusId =
                            button.getAttribute("data-id");

                        const inputValue =
                            button.getAttribute("data-input") || "";

                        const outputInput =
                            document.getElementById("endOutputQty");

                        const hint =
                            document.getElementById("endQtyHint");

                        document.getElementById("endStatusId").value =
                            statusId;

                        if (hint) {
                            hint.textContent =
                                inputValue
                                    ? "Input: " + inputValue
                                    : "";
                        }

                        const isCutting =
                            "@Model.DepartmentType" === "Cutting";

                        if (outputInput) {
                            outputInput.value = "";

                            outputInput.max =
                                isCutting
                                    ? ""
                                    : inputValue;
                        }

                        new bootstrap.Modal(
                            document.getElementById("endModal")
                        ).show();
                    });
                });

            // Quality modal open
            document
                .querySelectorAll(".btn-quality")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const articleId =
                            button.getAttribute("data-article");

                        const inputQuantity =
                            button.getAttribute("data-input") || "0";

                        document.getElementById("qualityArticleId").value =
                            articleId;

                        document
                            .getElementById("qualityModal")
                            .dataset.input = inputQuantity;

                        renderQualitySizes();

                        new bootstrap.Modal(
                            document.getElementById("qualityModal")
                        ).show();
                    });
                });

            function qualityKey() {
                return "quality-sizes-" +
                    document.getElementById("qualityArticleId").value;
            }

            function loadSavedQualityValues() {
                try {
                    return JSON.parse(
                        sessionStorage.getItem(qualityKey()) || "{}"
                    );
                }
                catch {
                    return {};
                }
            }

            function renderQualitySizes() {
                const tbody =
                    document.getElementById("qualitySizeRows");

                const saved =
                    loadSavedQualityValues();

                tbody.innerHTML = "";

                const details = getArticleDetails(document.getElementById("qualityArticleId").value);
                const cuttingSizes = (details && details.cuttingSizeBreakdowns) || [];
                cuttingSizes.forEach(function (cut) {
                    const size = cut.sizeLabel;
                    const cuttingQty = Number(cut.quantity) || 0;
                    const row =
                        document.createElement("tr");

                    const savedValue =
                        saved[size] ?? "";

                    row.innerHTML =
                        "<td class=\"fw-semibold\">" +
                        escapeHtml(size) +
                        "</td>" +
                        "<td class=\"cutting-qty\">" + cuttingQty + "</td>" +
                        "<td>" +
                        "<input type=\"text\" " +
                        "class=\"form-control form-control-sm size-qty\" " +
                        "data-size=\"" + escapeHtml(size) + "\" " +
                        "value=\"" + escapeHtml(savedValue) + "\" " +
                        "inputmode=\"numeric\" " +
                        "pattern=\"[0-9]*\" max=\"" + cuttingQty + "\" />" +
                        "</td><td class=\"size-difference\">" + cuttingQty + "</td>";

                    const input =
                        row.querySelector(".size-qty");

                    input.addEventListener(
                        "input",
                        function () {
                            this.value =
                                this.value.replace(/[^0-9]/g, "");

                            if (Number(this.value || 0) > cuttingQty) this.value = String(cuttingQty);
                            row.querySelector(".size-difference").textContent = cuttingQty - (Number(this.value) || 0);
                            saveQualityValues();
                            updateGrandTotal();
                        });

                    tbody.appendChild(row);
                });

                const bGrade =
                    document.getElementById("qualityBGrade");

                bGrade.value =
                    sessionStorage.getItem(
                        qualityKey() + "-b"
                    ) || "";

                bGrade.oninput = function () {
                    this.value =
                        this.value.replace(/[^0-9]/g, "");

                    sessionStorage.setItem(
                        qualityKey() + "-b",
                        this.value
                    );
                };

                updateGrandTotal();

                document
                    .getElementById("qualityReview")
                    .classList.add("d-none");

                document
                    .getElementById("qualityNoteWrap")
                    .classList.add("d-none");

                document
                    .getElementById("qualityBack")
                    .classList.add("d-none");

                document
                    .querySelectorAll(
                        "#qualitySizeRows input, #qualityBGrade"
                    )
                    .forEach(function (input) {
                        input.readOnly = false;
                    });

                document
                    .getElementById("qualitySubmit")
                    .textContent = "Confirm Table";

                document
                    .getElementById("qualitySubmit")
                    .onclick = confirmQualityTable;
            }

            function saveQualityValues() {
                const saved = {};

                document
                    .querySelectorAll(".size-qty")
                    .forEach(function (input) {
                        saved[input.dataset.size] =
                            input.value;
                    });

                sessionStorage.setItem(
                    qualityKey(),
                    JSON.stringify(saved)
                );
            }

            function updateGrandTotal() {
                let aGradeTotal = 0;

                document
                    .querySelectorAll(".size-qty")
                    .forEach(function (input) {
                        aGradeTotal +=
                            Number(input.value) || 0;
                    });

                document
                    .getElementById("qualityGrandTotal")
                    .textContent = aGradeTotal;

                const inputQuantity =
                    Number(
                        document
                            .getElementById("qualityModal")
                            .dataset.input || 0
                    );

                const maximumBGrade =
                    Math.max(0, inputQuantity - aGradeTotal);

                const bGrade =
                    document.getElementById("qualityBGrade");

                bGrade.max =
                    maximumBGrade;

                document
                    .getElementById("qualityBGradeHint")
                    .textContent =
                    "Maximum B-Grade: " + maximumBGrade;
            }

            function confirmQualityTable() {
                saveQualityValues();

                const inputQuantity =
                    Number(
                        document
                            .getElementById("qualityModal")
                            .dataset.input || 0
                    );

                let aGradeTotal = 0;

                document
                    .querySelectorAll(".size-qty")
                    .forEach(function (input) {
                        aGradeTotal +=
                            Number(input.value) || 0;
                    });

                const bGradeInput =
                    document.getElementById("qualityBGrade");

                const bGradeTotal =
                    bGradeInput.value.trim() === ""
                        ? 0
                        : Number(bGradeInput.value) || 0;

                const totalOutput =
                    aGradeTotal + bGradeTotal;

                if (totalOutput > inputQuantity) {
                    const maximumBGrade =
                        Math.max(
                            0,
                            inputQuantity - aGradeTotal
                        );

                    showToast(
                        "Invalid quantity. A-Grade is " +
                        aGradeTotal +
                        ". B-Grade can be maximum " +
                        maximumBGrade +
                        ". Total cannot exceed " +
                        inputQuantity +
                        ". Nothing was saved.",
                        "error"
                    );

                    return;
                }

                const values =
                    Array.from(
                        document.querySelectorAll(".size-qty")
                    )
                    .filter(function (input) {
                        return input.value.trim() !== "";
                    })
                    .map(function (input) {
                        return input.dataset.size +
                            ": " +
                            input.value;
                    });

                document
                    .getElementById("qualityReviewText")
                    .textContent =
                    (values.length
                        ? values.join(", ")
                        : "No A-Grade sizes entered") +
                    " | B-Grade: " +
                    bGradeTotal +
                    " | Total Output: " +
                    totalOutput;

                document
                    .getElementById("qualityReview")
                    .classList.remove("d-none");

                document
                    .getElementById("qualityNoteWrap")
                    .classList.remove("d-none");

                document
                    .getElementById("qualityBack")
                    .classList.remove("d-none");

                document
                    .querySelectorAll(
                        "#qualitySizeRows input, #qualityBGrade"
                    )
                    .forEach(function (input) {
                        input.readOnly = true;
                    });

                document
                    .getElementById("qualitySubmit")
                    .textContent = "End Work";

                document
                    .getElementById("qualitySubmit")
                    .onclick = submitQuality;
            }

            function submitQuality() {
                const labels = [];
                const quantities = [];

                document
                    .querySelectorAll(".size-qty")
                    .forEach(function (input) {
                        labels.push(input.dataset.size);
                        quantities.push(input.value || "0");
                    });

                document
                    .getElementById("qualitySizeLabels")
                    .value = labels.join("|");

                document
                    .getElementById("qualityQuantities")
                    .value = quantities.join("|");

                document
                    .getElementById("qualityModal")
                    .querySelector("form")
                    .submit();
            }

            document
                .getElementById("qualityBack")
                .addEventListener("click", function () {
                    document
                        .querySelectorAll(
                            "#qualitySizeRows input, #qualityBGrade"
                        )
                        .forEach(function (input) {
                            input.readOnly = false;
                        });

                    document
                        .getElementById("qualityReview")
                        .classList.add("d-none");

                    document
                        .getElementById("qualityNoteWrap")
                        .classList.add("d-none");

                    this.classList.add("d-none");

                    document
                        .getElementById("qualitySubmit")
                        .textContent = "Confirm Table";

                    document
                        .getElementById("qualitySubmit")
                        .onclick = confirmQualityTable;
                });

            // Fabric read-only modal
            document
                .querySelectorAll(".btn-view-fabrics")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        showFabricModal(
                            button.getAttribute("data-article")
                        );
                    });
                });

            function showFabricModal(articleId) {
                const article =
                    getArticleDetails(articleId);

                const tbody =
                    document.getElementById("managerFabricRows");

                const emptyMessage =
                    document.getElementById("managerNoFabrics");

                tbody.innerHTML = "";

                if (!article ||
                    !article.fabrics ||
                    article.fabrics.length === 0) {
                    emptyMessage.classList.remove("d-none");
                }
                else {
                    emptyMessage.classList.add("d-none");

                    article.fabrics.forEach(function (fabric) {
                        const row =
                            document.createElement("tr");

                        const status =
                            fabric.status === "OutOfStock"
                                ? '<span class="badge text-bg-danger">Out Of Stock</span>'
                                : '<span class="badge text-bg-success">In Stock</span>';

                        row.innerHTML =
                            "<td>" +
                            escapeHtml(fabric.fabricCode || "—") +
                            "</td>" +
                            "<td>" +
                            escapeHtml(fabric.fabricType || "—") +
                            "</td><td>" + escapeHtml(fabric.color || "—") +
                            "</td>" +
                            "<td>" +
                            escapeHtml(fabric.invNum || "—") +
                            "</td>" +
                            "<td>" +
                            escapeHtml(
                                String(fabric.quantityUsed ?? "0")
                            ) +
                            "</td>" +
                            "<td>" +
                            status +
                            "</td>";

                        tbody.appendChild(row);
                    });
                }

                new bootstrap.Modal(
                    document.getElementById("fabricViewModal")
                ).show();
            }

            // Read-only size table modal
            document
                .querySelectorAll(".btn-view-sizes")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        showSizeModal(
                            button.getAttribute("data-article")
                        );
                    });
                });

            function showSizeModal(articleId) {
                const article =
                    getArticleDetails(articleId);

                const tbody =
                    document.getElementById("managerSizeRows");

                const emptyMessage =
                    document.getElementById("managerNoSizes");

                tbody.innerHTML = "";

                const allStatuses = lossBreakdown[articleId] || [];

                const cuttingTotal = article?.cuttingSizeTotal ?? 0;
                const aGradeTotal = article?.aGradeQuantity ?? 0;
                const bGradeTotal = article?.bGradeQuantity ?? 0;
                const preQualityLoss = article?.preQualityLossQuantity ?? 0;
                const cGradeLoss = article?.cGradeQuantity ?? 0;

                const totalArticleLoss = allStatuses
                    .reduce(function (sum, item) {
                        return sum + (item.lossQuantity ?? 0);
                    }, 0);

                if (!article ||
                    !article.cuttingSizeBreakdowns ||
                    article.cuttingSizeBreakdowns.length === 0) {
                    emptyMessage.classList.remove("d-none");

                    document.getElementById("managerCuttingTotal").textContent = cuttingTotal;
                    document.getElementById("managerPreQualityLoss").textContent = preQualityLoss;
                    document.getElementById("managerAGradeTotal").textContent = aGradeTotal;
                    document.getElementById("managerBGradeTotal").textContent = bGradeTotal;
                    document.getElementById("managerCGradeTotal").textContent = cGradeLoss;
                }
                else {
                    emptyMessage.classList.add("d-none");

                    article.cuttingSizeBreakdowns
                        .slice()
                        .sort(function (a, b) {
                            return a.orderIndex - b.orderIndex;
                        })
                        .forEach(function (cuttingSize) {
                            const qualitySize = (article.sizeBreakdowns || []).find(function (qs) {
                                return qs.sizeLabel.toLowerCase() === cuttingSize.sizeLabel.toLowerCase();
                            });

                            const aGradeQty = qualitySize?.quantity ?? 0;
                            const delQty = qualitySize?.deliveredQuantity ?? 0;
                            const remQty = Math.max(0, aGradeQty - delQty);
                            const lossPerSize = cuttingSize.quantity - aGradeQty;

                            const row = document.createElement("tr");
                            row.innerHTML =
                                "<td><strong>" + escapeHtml(cuttingSize.sizeLabel) + "</strong></td>" +
                                "<td>" + String(cuttingSize.quantity) + "</td>" +
                                "<td>" + String(aGradeQty) + "</td>" +
                                "<td class=\"text-success fw-semibold\">" + String(delQty) + "</td>" +
                                "<td class=\"" + (remQty > 0 ? "text-warning fw-semibold" : "text-muted") + "\">" + String(remQty) + "</td>" +
                                "<td class=\"text-center\">" + String(lossPerSize) + "</td>";

                            tbody.appendChild(row);
                        });

                    document.getElementById("managerCuttingTotal").textContent = cuttingTotal;
                    document.getElementById("managerPreQualityLoss").textContent = preQualityLoss;
                    document.getElementById("managerAGradeTotal").textContent = aGradeTotal;
                    document.getElementById("managerBGradeTotal").textContent = bGradeTotal;
                    document.getElementById("managerCGradeTotal").textContent = cGradeLoss;
                }

                // Build department loss breakdown
                let deptLossHtml = "<div class=\"row\">";
                let deptCount = 0;

                allStatuses.forEach(function (status) {
                    if (status.lossQuantity !== null && status.lossQuantity > 0) {
                        if (deptCount > 0 && deptCount % 2 === 0) {
                            deptLossHtml += "</div><div class=\"row\">";
                        }
                        deptLossHtml += "<div class=\"col-md-6 mb-2\">" +
                            "<div class=\"badge bg-warning text-dark\" style=\"font-size: 0.9em; width: 100%; padding: 0.5em;\">" +
                            "<strong>" + escapeHtml(status.departmentName || "Unknown") + ":</strong> " +
                            status.lossQuantity + " pieces" +
                            "</div></div>";
                        deptCount++;
                    }
                });

                deptLossHtml += "</div>";

                const deptContainer = document.getElementById("managerDepartmentLossBreakdown");
                if (deptCount === 0) {
                    deptContainer.innerHTML = "<p class=\"text-muted mb-0\">No department losses recorded yet.</p>";
                } else {
                    deptContainer.innerHTML = deptLossHtml;
                }

                document.getElementById("managerTotalArticleLoss").textContent = totalArticleLoss;

                new bootstrap.Modal(
                    document.getElementById("sizeViewModal")
                ).show();
            }

            // =========================================================================
            // Partial Size-Wise Delivery Modal
            // =========================================================================
            let activeDeliveryRemainingTotal = 0;
            let activeDeliveryBGradeRemaining = 0;

            document
                .querySelectorAll(".btn-delivery")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const articleId = button.getAttribute("data-article");
                        openDeliveryModal(articleId);
                    });
                });

            function openDeliveryModal(articleId) {
                document.getElementById("deliveryArticleId").value = articleId;

                const article = getArticleDetails(articleId);
                document.getElementById("deliveryModalArticleTitle").textContent =
                    article ? (article.articleCode + " (" + (article.category || "Knit") + ")") : ("#" + articleId);

                const totalDeliverable = article?.totalDeliverableQuantity ?? 0;
                const alreadyDelivered = article?.totalDeliveredQuantity ?? 0;
                const remainingTotal = Math.max(0, totalDeliverable - alreadyDelivered);
                activeDeliveryRemainingTotal = remainingTotal;

                document.getElementById("delSumTotal").textContent = totalDeliverable;
                document.getElementById("delSumDelivered").textContent = alreadyDelivered;
                document.getElementById("delSumRemaining").textContent = remainingTotal;

                const tbody = document.getElementById("deliverySizeRows");
                tbody.innerHTML = "";

                const sizeBreakdowns = (article && article.sizeBreakdowns) ? article.sizeBreakdowns : [];
                sizeBreakdowns.forEach(function (sb) {
                    const totalQty = Number(sb.quantity) || 0;
                    const delQty = Number(sb.deliveredQuantity) || 0;
                    const remQty = Math.max(0, totalQty - delQty);

                    const tr = document.createElement("tr");
                    tr.innerHTML =
                        "<td class=\"fw-semibold\">" + escapeHtml(sb.sizeLabel) + "</td>" +
                        "<td>" + totalQty + "</td>" +
                        "<td class=\"text-success\">" + delQty + "</td>" +
                        "<td class=\"fw-semibold " + (remQty > 0 ? "text-primary" : "text-muted") + "\">" + remQty + "</td>" +
                        "<td>" +
                        "<input type=\"text\" class=\"form-control form-control-sm delivery-size-input\" " +
                        "data-size=\"" + escapeHtml(sb.sizeLabel) + "\" " +
                        "data-remaining=\"" + remQty + "\" " +
                        "inputmode=\"numeric\" pattern=\"[0-9]*\" placeholder=\"0\" " +
                        (remQty <= 0 ? "disabled value=\"0\"" : "") + " />" +
                        "</td>";

                    const inp = tr.querySelector(".delivery-size-input");
                    inp.addEventListener("input", function () {
                        this.value = this.value.replace(/[^0-9]/g, "");
                        const maxRem = Number(this.dataset.remaining) || 0;
                        if (Number(this.value || 0) > maxRem) {
                            this.value = String(maxRem);
                        }
                        recalcDeliveryBatchSummary();
                    });

                    tbody.appendChild(tr);
                });

                const bGradeTotal = Number(article?.bGradeQuantity) || 0;
                const bGradeDel = Number(article?.deliveredBGradeQuantity) || 0;
                const bGradeRem = Math.max(0, bGradeTotal - bGradeDel);
                activeDeliveryBGradeRemaining = bGradeRem;

                document.getElementById("delBGradeTotal").textContent = bGradeTotal;
                document.getElementById("delBGradeDelivered").textContent = bGradeDel;
                document.getElementById("delBGradeRemaining").textContent = bGradeRem;

                const bInput = document.getElementById("deliveryBGradeInput");
                bInput.value = "";
                bInput.disabled = bGradeRem <= 0;
                bInput.oninput = function () {
                    this.value = this.value.replace(/[^0-9]/g, "");
                    if (Number(this.value || 0) > activeDeliveryBGradeRemaining) {
                        this.value = String(activeDeliveryBGradeRemaining);
                    }
                    recalcDeliveryBatchSummary();
                };

                // Previous batches summary
                const prevWrap = document.getElementById("deliveryPreviousBatchesWrap");
                const prevList = document.getElementById("deliveryPreviousBatchesList");
                const batches = (article && article.deliveryBatches) ? article.deliveryBatches : [];
                if (batches.length > 0) {
                    prevWrap.classList.remove("d-none");
                    prevList.innerHTML = batches.map(function (b) {
                        const itemsText = (b.items || []).map(function (i) {
                            return escapeHtml(i.sizeLabel) + ": " + i.quantityDelivered;
                        }).join(", ");
                        return "<div class=\"mb-1\">" +
                            "<span class=\"badge text-bg-dark me-1\">Batch #" + b.batchNumber + "</span>" +
                            "<strong>" + b.totalDeliveredInBatch + " pcs</strong> " +
                            (itemsText ? "(" + itemsText + (b.bGradeDelivered > 0 ? ", B-Grade: " + b.bGradeDelivered : "") + ")" : "") +
                            "</div>";
                    }).join("");
                } else {
                    prevWrap.classList.add("d-none");
                    prevList.innerHTML = "";
                }

                document.getElementById("deliveryPackedBy").value = article?.packedBy || "";
                document.getElementById("deliveryCheckedBy").value = article?.checkedBy || "";
                document.getElementById("deliveryNoOfCartons").value = "";
                document.getElementById("deliveryNote").value = "";

                recalcDeliveryBatchSummary();

                new bootstrap.Modal(
                    document.getElementById("deliveryModal")
                ).show();
            }

            function recalcDeliveryBatchSummary() {
                let batchSum = 0;
                document.querySelectorAll(".delivery-size-input").forEach(function (inp) {
                    batchSum += Number(inp.value) || 0;
                });
                const bInput = document.getElementById("deliveryBGradeInput");
                batchSum += Number(bInput.value) || 0;

                document.getElementById("delBatchTotalNow").textContent = batchSum;
                document.getElementById("delAfterBatchRemaining").textContent =
                    Math.max(0, activeDeliveryRemainingTotal - batchSum);
            }

            document.getElementById("btnDeliverFillAll").addEventListener("click", function () {
                document.querySelectorAll(".delivery-size-input").forEach(function (inp) {
                    const rem = Number(inp.dataset.remaining) || 0;
                    inp.value = rem > 0 ? String(rem) : "0";
                });
                const bInput = document.getElementById("deliveryBGradeInput");
                if (!bInput.disabled) {
                    bInput.value = activeDeliveryBGradeRemaining > 0 ? String(activeDeliveryBGradeRemaining) : "0";
                }
                recalcDeliveryBatchSummary();
            });

            document.getElementById("btnDeliverClearAll").addEventListener("click", function () {
                document.querySelectorAll(".delivery-size-input").forEach(function (inp) {
                    inp.value = "";
                });
                document.getElementById("deliveryBGradeInput").value = "";
                recalcDeliveryBatchSummary();
            });

            document.getElementById("deliveryForm").addEventListener("submit", function (e) {
                const labels = [];
                const quantities = [];
                let totalNow = 0;

                document.querySelectorAll(".delivery-size-input").forEach(function (inp) {
                    labels.push(inp.dataset.size);
                    const q = Number(inp.value) || 0;
                    quantities.push(String(q));
                    totalNow += q;
                });

                const bNow = Number(document.getElementById("deliveryBGradeInput").value) || 0;
                totalNow += bNow;

                if (activeDeliveryRemainingTotal > 0 && totalNow <= 0) {
                    e.preventDefault();
                    if (window.showToast) {
                        showToast("Enter at least 1 piece to deliver in this batch (or click 'Deliver All Remaining').", "warning");
                    }
                    return false;
                }

                document.getElementById("deliverySizeLabels").value = labels.join("|");
                document.getElementById("deliverySizeQuantities").value = quantities.join("|");
                return true;
            });

            document
                .getElementById("deliverySizesButton")
                .addEventListener("click", function () {
                    const articleId =
                        document
                            .getElementById("deliveryArticleId")
                            .value;

                    if (articleId) {
                        showSizeModal(articleId);
                    }
                });

            document
                .getElementById("deliveryBatchesButton")
                ?.addEventListener("click", function () {
                    const articleId = document.getElementById("deliveryArticleId").value;
                    if (articleId) {
                        showDeliveryTableModal(articleId);
                    }
                });

            document
                .querySelectorAll(".btn-view-delivery-table")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        showDeliveryTableModal(button.getAttribute("data-article"));
                    });
                });

            function showDeliveryTableModal(articleId) {
                const article = getArticleDetails(articleId);
                document.getElementById("delViewModalArticleTitle").textContent =
                    article ? article.articleCode : ("#" + articleId);

                const totalDeliv = article?.totalDeliverableQuantity ?? 0;
                const totalDone = article?.totalDeliveredQuantity ?? 0;
                const totalRem = Math.max(0, totalDeliv - totalDone);

                document.getElementById("delViewSumTotal").textContent = totalDeliv;
                document.getElementById("delViewSumDelivered").textContent = totalDone;
                document.getElementById("delViewSumRemaining").textContent = totalRem;
                document.getElementById("delViewPackedBy").textContent = article?.packedBy || "—";
                document.getElementById("delViewCheckedBy").textContent = article?.checkedBy || "—";
                document.getElementById("delViewCartons").textContent = article?.noOfCartons ?? "—";

                const sizeBody = document.getElementById("delViewSizeRows");
                sizeBody.innerHTML = "";
                ((article && article.sizeBreakdowns) || []).forEach(function (sb) {
                    const q = Number(sb.quantity) || 0;
                    const d = Number(sb.deliveredQuantity) || 0;
                    const r = Math.max(0, q - d);
                    const tr = document.createElement("tr");
                    tr.innerHTML =
                        "<td class=\"fw-semibold\">" + escapeHtml(sb.sizeLabel) + "</td>" +
                        "<td>" + q + "</td>" +
                        "<td class=\"text-success fw-semibold\">" + d + "</td>" +
                        "<td class=\"" + (r > 0 ? "text-warning fw-semibold" : "text-muted") + "\">" + r + "</td>";
                    sizeBody.appendChild(tr);
                });

                const bTot = Number(article?.bGradeQuantity) || 0;
                const bDel = Number(article?.deliveredBGradeQuantity) || 0;
                const bRem = Math.max(0, bTot - bDel);
                document.getElementById("delViewBTotal").textContent = bTot;
                document.getElementById("delViewBDelivered").textContent = bDel;
                document.getElementById("delViewBRemaining").textContent = bRem;
                document.getElementById("delViewGrandTotal").textContent = totalDeliv;
                document.getElementById("delViewGrandDelivered").textContent = totalDone;
                document.getElementById("delViewGrandRemaining").textContent = totalRem;

                const batchBody = document.getElementById("delViewBatchRows");
                batchBody.innerHTML = "";
                const batches = (article && article.deliveryBatches) || [];
                if (batches.length === 0) {
                    batchBody.innerHTML = "<tr><td colspan=\"9\" class=\"text-muted text-center\">No delivery batches recorded yet.</td></tr>";
                } else {
                    batches.forEach(function (b) {
                        const itemsText = (b.items || []).map(function (i) {
                            return escapeHtml(i.sizeLabel) + ": " + i.quantityDelivered;
                        }).join(", ") || "—";
                        const dt = b.deliveredAt ? new Date(b.deliveredAt).toLocaleString("en-GB", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", hour12: true }) : "—";
                        const tr = document.createElement("tr");
                        tr.innerHTML =
                            "<td><span class=\"badge text-bg-dark\">#" + b.batchNumber + "</span></td>" +
                            "<td>" + escapeHtml(dt) + "</td>" +
                            "<td>" + itemsText + "</td>" +
                            "<td>" + (b.bGradeDelivered ?? 0) + "</td>" +
                            "<td><span class=\"badge text-bg-success\">" + b.totalDeliveredInBatch + " pcs</span></td>" +
                            "<td>" + escapeHtml(b.packedBy || "—") + "</td>" +
                            "<td>" + escapeHtml(b.checkedBy || "—") + "</td>" +
                            "<td>" + (b.noOfCartons ?? "—") + "</td>" +
                            "<td>" + escapeHtml(b.note || "—") + "</td>";
                        batchBody.appendChild(tr);
                    });
                }

                new bootstrap.Modal(document.getElementById("deliveryTableViewModal")).show();
            }
        })();
    </script>
}
