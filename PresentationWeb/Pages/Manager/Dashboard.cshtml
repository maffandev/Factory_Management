@page "/Manager/Dashboard"
@model DashboardModel
@using System.Text.Json

@{
    ViewData["Title"] = "Manager Dashboard";
    var dept = Model.Department;
    var isBoth = string.Equals(Model.UserCategory, "Both", StringComparison.OrdinalIgnoreCase);

    var articleDetailsJson =
        JsonSerializer.Serialize(
            Model.ArticleDetails,
            new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            });

    var statusesJson =
        JsonSerializer.Serialize(
            Model.Statuses,
            new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            });

    var lossBreakdownJson =
        JsonSerializer.Serialize(
            Model.LossBreakdown,
            new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            });
}

@await Html.PartialAsync("_Navbar")
@Html.AntiForgeryToken()

<div class="container-fluid px-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h4 class="mb-0">
            @(dept?.Name ?? "Department") Dashboard
        </h4>

        @if (isBoth)
        {
            <!-- Easy-to-use Category Filter Buttons for 'Both' User -->
            <div class="btn-group" role="group" aria-label="Category Quick Filter" id="catQuickFilter">
                <button type="button" class="btn btn-primary cat-filter-btn active" data-cat="All">
                    <span class="bi bi-collection me-1"></span>All
                </button>
                <button type="button" class="btn btn-outline-primary cat-filter-btn" data-cat="Knit">
                    <span class="bi bi-layers me-1"></span>Knit
                </button>
                <button type="button" class="btn btn-outline-primary cat-filter-btn" data-cat="Woven">
                    <span class="bi bi-grid-3x3-gap me-1"></span>Woven
                </button>
            </div>
        }
        else
        {
            <span class="badge @(Model.UserCategory == "Woven" ? "text-bg-warning text-dark" : "text-bg-primary") fs-6 px-3 py-2">
                Category: @Model.UserCategory Only
            </span>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Statuses.Any(s => s.IsDelayed))
    {
        var todayPk = Domain.Common.PakistanTime.Today.ToString("yyyy-MM-dd");
        <div class="alert alert-danger py-1 px-3 mb-2 d-none align-items-center justify-content-between shadow-sm border-danger border-start border-4 small"
             id="mgrDelayCompactBanner"
             data-today="@todayPk">
            <div class="text-truncate me-2">
                <span class="bi bi-exclamation-triangle-fill me-1"></span>
                <strong>@Model.Statuses.Count(s => s.IsDelayed) article(s)</strong> delayed (&gt; 3 days in queue)
            </div>
            <button type="button" class="btn-close" style="font-size:0.65rem;" id="btnDismissMgrDelayBanner" title="Dismiss for today (will remind again tomorrow)" aria-label="Close"></button>
        </div>
        <script>
            (function () {
                var b = document.getElementById('mgrDelayCompactBanner');
                if (!b) return;
                var tk = b.getAttribute('data-today');
                var key = 'ka_mgr_delay_dismiss_' + @(Model.Department?.Id ?? 0);
                if (localStorage.getItem(key) !== tk) {
                    b.classList.remove('d-none');
                    b.classList.add('d-flex');
                }
                document.getElementById('btnDismissMgrDelayBanner')?.addEventListener('click', function () {
                    localStorage.setItem(key, tk);
                    b.classList.remove('d-flex');
                    b.classList.add('d-none');
                });
            })();
        </script>
    }

    @if (Model.DepartmentType == Domain.Enums.DepartmentType.Pattern && Model.SamplingApprovals.Any())
    {
        <div class="card shadow-sm border-warning mb-3">
            <div class="card-header bg-warning-subtle fw-semibold">Sampling Approval Requests</div>
            <div class="card-body table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Article</th><th>Category</th><th>Company</th><th>Attempt</th><th>Submitted</th><th class="text-end">Decision</th></tr></thead>
                    <tbody>
                    @foreach (var request in Model.SamplingApprovals)
                    {
                        var rCatBadge = request.Category == "Woven" ? "text-bg-warning text-dark" : "text-bg-primary";
                        <tr class="cat-filterable-row" data-category="@request.Category">
                            <td class="fw-semibold">@request.ArticleCode</td>
                            <td><span class="badge @rCatBadge">@request.Category</span></td>
                            <td>@request.CompanyName</td>
                            <td>@request.SamplingAttemptCount</td>
                            <td>@request.SamplingSubmittedAt?.ToString("dd MMM yyyy hh:mm tt")</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="ReviewSampling" class="d-inline-flex gap-2 align-items-center">
                                    <input type="hidden" name="statusId" value="@request.Id" />
                                    <input type="text" name="note" class="form-control form-control-sm" placeholder="Optional note" />
                                    <button name="approved" value="true" class="btn btn-sm btn-success">Approve</button>
                                    <button name="approved" value="false" class="btn btn-sm btn-danger">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }


    <div class="card shadow-sm">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span>Work Queue</span>
            <input type="text"
                   id="mgrSearchInput"
                   class="form-control form-control-sm"
                   style="max-width: 280px;"
                   placeholder="Search article code or company..."
                   autocomplete="off" />
        </div>

        <div class="card-body table-responsive">
            @if (Model.Statuses.Any())
            {
                <table class="table table-hover align-middle mb-0" id="workQueueTable">
                    <thead>
                        <tr>
                            <th>Article</th>
                            <th>Category</th>
                            <th>Company</th>
                            <th>Delivery</th>
                            <th>Input</th>
                            <th>Output</th>
                            <th>Loss</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var s in Model.Statuses)
                        {
                            var badge = s.Status switch
                            {
                                "Done" => "text-bg-success",
                                "InProcess" => "text-bg-warning",
                                _ => "text-bg-secondary"
                            };
                            var catBadge = s.Category == "Woven" ? "text-bg-warning text-dark" : "text-bg-primary";

                            <tr class="cat-filterable-row @(s.IsDelayed ? "table-danger border-start border-danger border-4" : "")"
                                data-status-id="@s.Id"
                                data-article-id="@s.ArticleId"
                                data-category="@s.Category">

                                <td class="fw-semibold">
                                    <a href="/Manager/ArticleDetail/@s.ArticleId" class="text-decoration-none">@s.ArticleCode</a>

                                    @if (s.IsPinned)
                                    {
                                        <span class="bi bi-pin-fill text-warning"></span>
                                    }
                                    @if (s.IsDelayed)
                                    {
                                        <span class="badge text-bg-danger ms-1" title="Delayed (@s.ElapsedDays days)">
                                            <span class="bi bi-exclamation-triangle-fill me-1"></span>@s.ElapsedDays d
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="badge @catBadge">@s.Category</span>
                                </td>

                                <td>
                                    @s.CompanyName
                                </td>

                                <td>
                                    @(s.DeliveryDate?.ToString("dd MMM yyyy") ?? "—")
                                </td>

                                <td>
                                    @(s.InputQuantity?.ToString() ?? "—")
                                </td>

                                <td>
                                    @if (Model.DepartmentType == Domain.Enums.DepartmentType.Delivery && s.TotalDeliverableQuantity > 0)
                                    {
                                        <span class="badge text-bg-success">Delivered: @s.TotalDeliveredQuantity / @s.TotalDeliverableQuantity</span>
                                        <div class="small text-muted">Left: @s.RemainingDeliverableQuantity pcs</div>
                                    }
                                    else
                                    {
                                        @(s.OutputQuantity?.ToString() ?? "—")
                                    }
                                </td>

                                <td>
                                    @(s.LossQuantity?.ToString() ?? "—")
                                </td>

                                <td>
                                    <span class="badge @badge">
                                        @s.Status
                                    </span>
                                </td>

                                <td class="text-end text-nowrap">
                                    @if (Model.ArticleDetails.ContainsKey(s.ArticleId))
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-info btn-view-fabrics"
                                                data-article="@s.ArticleId">
                                            <span class="bi bi-box-seam me-1"></span>
                                            Fabrics
                                        </button>
                                    }

                                    @if (Model.DepartmentType == Domain.Enums.DepartmentType.Delivery &&
                                         Model.ArticleDetails.ContainsKey(s.ArticleId))
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary btn-view-sizes"
                                                data-article="@s.ArticleId">
                                            <span class="bi bi-table me-1"></span>
                                            Show Size Table
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-success btn-view-delivery-table"
                                                data-article="@s.ArticleId">
                                            <span class="bi bi-clock-history me-1"></span>
                                            Show Delivery Table
                                        </button>
                                    }

                                    @if (s.Status == "Pending")
                                    {
                                        @if (Model.DepartmentType == Domain.Enums.DepartmentType.Stitching)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary btn-start-team"
                                                    data-id="@s.Id">
                                                Start
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary btn-start"
                                                    data-id="@s.Id">
                                                Start
                                            </button>
                                        }
                                    }
                                    else if (s.Status == "InProcess")
                                    {
                                        @if (Model.DepartmentType == Domain.Enums.DepartmentType.QualityAndPacking)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-success btn-quality"
                                                    data-article="@s.ArticleId"
                                                    data-input="@(s.InputQuantity ?? 0)">
                                                End
                                            </button>
                                        }
                                        else if (Model.DepartmentType == Domain.Enums.DepartmentType.Delivery)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-success btn-delivery"
                                                    data-article="@s.ArticleId">
                                                <span class="bi bi-truck me-1"></span>Deliver Pieces
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-success btn-end"
                                                    data-id="@s.Id"
                                                    data-input="@(s.InputQuantity?.ToString() ?? "")">
                                                End
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            Done
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="text-muted mt-3 mb-0 d-none" id="noCatMatchMsg">No articles in this category filter.</p>
            }
            else
            {
                <p class="text-muted mb-0">
                    No pending work in your department.
                </p>
            }
        </div>
    </div>
</div>

<!-- Generic Start modal -->
<div class="modal fade"
     id="startModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="Start">

                <input type="hidden"
                       name="statusId"
                       id="startStatusId" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        Start Work
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Start work on this department?
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Start
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Stitching Start modal -->
<div class="modal fade"
     id="startTeamModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="Start">

                <input type="hidden"
                       name="statusId"
                       id="startTeamStatusId" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        Start Stitching
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <label class="form-label">
                        Select Team
                    </label>

                    <select name="teamId"
                            class="form-select"
                            required>

                        <option value="">
                            Choose team...
                        </option>

                        @foreach (var t in Model.Teams)
                        {
                            <option value="@t.Id">
                                @t.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Start
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Generic End Work modal -->
<div class="modal fade"
     id="endModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="endWorkForm"
                  asp-page-handler="End">

                <input type="hidden"
                       name="statusId"
                       id="endStatusId" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        End Work
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    @if (Model.DepartmentType is
                        Domain.Enums.DepartmentType.Pattern or
                        Domain.Enums.DepartmentType.Sampling)
                    {
                        <p class="text-muted small mb-2">
                            No quantity entry is required for this department.
                        </p>

                        <div class="mb-2">
                            <label class="form-label">
                                Note
                            </label>

                            <textarea name="note"
                                      class="form-control"
                                      rows="2"></textarea>
                        </div>
                    }
                    else
                    {
                        @if (Model.DepartmentType == Domain.Enums.DepartmentType.Cutting)
                        {
                            <input type="hidden" name="cuttingSizeLabels" id="cuttingSizeLabels" />
                            <input type="hidden" name="cuttingQuantities" id="cuttingQuantities" />
                            <div class="table-responsive mb-2">
                                <table class="table table-sm table-bordered align-middle mb-0">
                                    <thead><tr><th>Size</th><th style="width:160px;">Cut Quantity</th></tr></thead>
                                    <tbody id="cuttingSizeRows"></tbody>
                                    <tfoot><tr><th>Total Cutting Output</th><th id="cuttingGrandTotal">0</th></tr></tfoot>
                                </table>
                            </div>
                            <div class="form-text small">The size total will be saved as Cutting output.</div>
                        }
                        else
                        {
                            <div class="mb-2">
                                <label class="form-label">Output Quantity</label>
                                <input type="number" name="outputQty" min="0" max="" step="1"
                                       inputmode="numeric" class="form-control" id="endOutputQty" />
                                <div class="form-text small" id="endQtyHint"></div>
                            </div>
                        }

                        @if (Model.DepartmentType ==
                            Domain.Enums.DepartmentType.Stitching)
                        {
                            <div class="mb-2">
                                <label class="form-label">
                                    Stitched By (Name)
                                    <span class="text-danger">*</span>
                                </label>

                                <input type="text"
                                       name="stitchedBy"
                                       class="form-control"
                                       required />
                            </div>
                        }

                        <div class="mb-2">
                            <label class="form-label">
                                Note
                            </label>

                            <textarea name="note"
                                      class="form-control"
                                      rows="2"></textarea>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        End Work
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Quality & Packing modal -->
<div class="modal fade"
     id="qualityModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="Quality">

                <input type="hidden"
                       name="articleId"
                       id="qualityArticleId" />

                <input type="hidden"
                       name="sizeLabels"
                       id="qualitySizeLabels" />

                <input type="hidden"
                       name="quantities"
                       id="qualityQuantities" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        Quality &amp; Packing — Grades
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <p class="text-muted small mb-2">
                        Enter whole-number quantities for the applicable sizes.
                    </p>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Size</th>
                                    <th style="width:130px;">Cutting Qty</th>
                                    <th style="width:140px;">A-Grade Quantity</th>
                                    <th style="width:120px;">Difference</th>
                                </tr>
                            </thead>

                            <tbody id="qualitySizeRows">
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th colspan="2">Total A-Grade</th>
                                    <th id="qualityGrandTotal">0</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="row g-2 mt-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                B-Grade Quantity
                            </label>

                            <input type="text"
                                   name="bGrade"
                                   id="qualityBGrade"
                                   class="form-control"
                                   value=""
                                   inputmode="numeric"
                                   pattern="[0-9]*" />

                            <div class="form-text small"
                                 id="qualityBGradeHint">
                                Maximum depends on A-Grade total.
                            </div>
                        </div>
                    </div>

                    <div id="qualityReview"
                         class="alert alert-info d-none mt-3 mb-0">

                        <strong>
                            Confirmed Table Review
                        </strong>

                        <div id="qualityReviewText"
                             class="small mt-1">
                        </div>
                    </div>

                    <div id="qualityNoteWrap"
                         class="mt-3 d-none">

                        <label class="form-label">
                            Note
                        </label>

                        <textarea name="note"
                                  id="qualityNote"
                                  class="form-control"
                                  rows="2"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary d-none"
                            id="qualityBack">
                        Back / Edit
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            id="qualitySubmit">
                        Confirm Table
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Article Fabrics read-only modal -->
<div class="modal fade"
     id="fabricViewModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Article Fabrics
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <div class="table-responsive"
                     id="managerFabricTableWrapper">

                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fabric Code</th>
                                <th>Fabric Type</th>
                                <th>Color</th>
                                <th>Invoice</th>
                                <th>Used Quantity</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody id="managerFabricRows">
                        </tbody>
                    </table>
                </div>

                <p id="managerNoFabrics"
                   class="text-muted mb-0 d-none">
                    No fabrics linked to this article.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Read-only Size Table modal -->
<div class="modal fade"
     id="sizeViewModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Quality &amp; Packing Size Table
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <p class="text-muted small">
                    Complete size breakdown comparison showing Cutting, Quality Processing, Delivered Quantities, and Loss tracking.
                </p>

                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-3">
                        <thead>
                            <tr>
                                <th>Size</th>
                                <th>Cutting Qty</th>
                                <th>A-Grade Qty</th>
                                <th>Delivered Qty</th>
                                <th>Remaining</th>
                                <th>Loss Per Size</th>
                            </tr>
                        </thead>

                        <tbody id="managerSizeRows">
                        </tbody>

                        <tfoot>
                            <tr class="fw-bold">
                                <th>Cutting Total</th>
                                <th id="managerCuttingTotal">0</th>
                                <th colspan="4"></th>
                            </tr>

                            <tr>
                                <th>Loss Before Quality</th>
                                <th id="managerPreQualityLoss">0</th>
                                <th colspan="4"></th>
                            </tr>

                            <tr>
                                <th>Total A-Grade</th>
                                <th id="managerAGradeTotal">0</th>
                                <th colspan="4"></th>
                            </tr>

                            <tr>
                                <th>B-Grade Total</th>
                                <th id="managerBGradeTotal">0</th>
                                <th colspan="4"></th>
                            </tr>

                            <tr class="table-warning">
                                <th>C-Grade / Quality Loss</th>
                                <th id="managerCGradeTotal">0</th>
                                <th colspan="4"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Department Loss Breakdown -->
                <div class="card card-sm mt-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Department Loss Breakdown</h6>
                    </div>
                    <div class="card-body" id="managerDepartmentLossBreakdown">
                    </div>
                </div>

                <!-- Total Article Loss Summary -->
                <div class="alert alert-danger mt-3 mb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong>Total Article Loss (All Departments):</strong>
                        <span id="managerTotalArticleLoss" class="fs-5 fw-bold">0</span>
                        <span class="text-muted">pieces</span>
                    </div>
